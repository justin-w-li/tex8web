-- make4ht build file for tex8web: HTML that looks like the PDF, with MathJax
-- typesetting the math from its LaTeX source. Use with tex8web.cfg, or a
-- config that \inputs tex8web-core.tex:
--   make4ht -c path/to/tex8web.cfg -e path/to/tex8web.mk4 -B build/tex4ht -d build/html document.tex
-- Sets TeX's and Lua's search paths and the build steps, and runs the HTML
-- passes (lua/tex8web/) and prerendering (prerender.lua). See "How it works"
-- in CONTRIBUTING.md.
-- (make4ht runs this file from a string; settings.build_file is its path)
local root = settings.build_file:match("^(.*)[/\\]") or "."
-- (texlua's require does not search package.path, so a searcher for lua/
-- is added)
table.insert(package.searchers, 2, function(name)
  local path, message = package.searchpath(name, root .. "/lua/?.lua")
  if not path then return message end
  return loadfile(path), path
end)
-- The folders on TEXINPUTS outside TeX's trees, as kpathsea expands them
-- (//, $VAR, ~, and braces), hold files of the document's, as a
-- .latexmkrc's ensure_path adds them. tex8web-hooks.sty reads them from a
-- file that the step "texinputs" below writes. tex8web's folder, which
-- bin/tex8web adds for the default config, is left out.
local owndirs = {}
do
  local here = lfs.currentdir()
  local function absolute(path)
    local parts = {}
    for part in (path:sub(1, 1) == "/" and path or here .. "/" .. path):gmatch("[^/]+") do
      if part == ".." then parts[#parts] = nil elseif part ~= "." then parts[#parts + 1] = part end
    end
    return "/" .. table.concat(parts, "/")
  end
  local trees, seen = {absolute(root .. "/tex")}, {[absolute(root)] = true}
  for tree in kpse.expand_braces("$TEXMF"):gmatch("[^:]+") do trees[#trees + 1] = absolute((tree:gsub("^!!", ""))) end
  for dir in kpse.expand_path(os.getenv("TEXINPUTS") or ""):gmatch("[^:]+") do
    dir = absolute(dir)
    local inside = seen[dir]
    for _, tree in ipairs(trees) do
      if dir == tree or dir:sub(1, #tree + 1) == tree .. "/" then inside = true end
    end
    if not inside then
      seen[dir] = true
      owndirs[#owndirs + 1] = dir
    end
  end
end
os.setenv("TEXINPUTS", root .. "/tex:" .. (os.getenv("TEXINPUTS") or ""))

local domfilter = require "make4ht-domfilter"

-- make4ht-domfilter.lua reads a page that is not well-formed XML with
-- LuaXML's HTML reader. That reader (luaxml-mod-html.lua) puts a character
-- reference that follows a start tag into the tag's last attribute, as it
-- tests the last token instead of the state the reference returns to. It
-- also drops the character after a numeric reference's semicolon. Text then
-- loses characters, and a lost < shows a tag as text.
do
  local html = require "luaxml-mod-html"
  local parser, states = html.HtmlParser, html.HtmlStates
  function parser:flush_temp_buffer()
    for _, char in ipairs(self.temp_buffer) do
      if self.return_state:match("^attribute_value") then
        table.insert(self.current_token.current_attr_value, char)
      else
        self:emit_character(char)
      end
    end
    self.temp_buffer = {}
  end
  function parser:add_entity(char)
    self.temp_buffer = {char}
    self:flush_temp_buffer()
  end
  for _, name in ipairs({"decimal_character_reference", "hexadecimal_character_reference"}) do
    local state = states[name]
    states[name] = function(self)
      if self.codepoint == 0x3B then return self:tokenize("numeric_reference_end_state") end
      return state(self)
    end
  end
end
local errorlogparser = require "make4ht-errorlogparser"
local fixinlines = require "make4ht-fixinlines"
local htlatex = require "make4ht-htlatex"
local assets = require "tex8web.assets"
local bibliography = require "tex8web.bibliography"
local dvi = require "tex8web.dvi"
local files = require "tex8web.files"
local htf = require "tex8web.htf"
local index = require "tex8web.index"
local macros = require "tex8web.macros"
local page = require "tex8web.page"
local prerender = require "tex8web.prerender"
local source = require "tex8web.source"
local text = require "tex8web.text"

local log = logging.new("tex8web")

-- LaTeX, with tex/tex8web-hooks.sty loaded before the preamble and tex4ht's
-- fn-in option, which keeps footnotes on the page (text.lua moves them
-- beside the text); then bibtex or biber, makeindex, and makeglossaries,
-- which make4ht does not run, if the document needs them; then LaTeX until
-- the cross-references and the indexes' input files settle, with makeindex
-- again before each run while those change, and makeglossaries, makeindex,
-- and LaTeX while the glossaries or indexes change. (The parameters extend
-- settings, because Make.params is still empty here.)
local latex = {packages = settings.packages .. "\\RequirePackage{tex8web-hooks}",
  tex4ht_sty_par = settings.tex4ht_sty_par .. ",fn-in"}
-- The tests' builds (test/lib/build.mjs) copy LaTeX's build directory into
-- TEX8WEB_LATEX_SAVE, an empty directory that they make, so that a runner
-- can mount exactly that directory. When nothing LaTeX reads has changed,
-- they pass that copy as TEX8WEB_LATEX_REUSE, which is copied back in place
-- of running LaTeX if it holds the DVI. The marks around LaTeX's part of the
-- log let the tests save that part too.
local save, reuse = os.getenv("TEX8WEB_LATEX_SAVE"), os.getenv("TEX8WEB_LATEX_REUSE")
if reuse and not lfs.attributes(reuse .. "/" .. settings.input .. "." .. settings.dvi) then reuse = nil end
local function mark(name)
  io.stdout:flush()
  print("tex8web-latex-" .. name)
  io.stdout:flush()
end
if reuse then
  -- (given LaTeX's parameters, which make4ht keeps for the commands after
  -- it; correct_exit makes a failed tex4ht or t4ht fatal)
  Make:add("latex_reused", function(par)
    mark("begin")
    mark("end")
    return os.execute("cp -R " .. files.quote(reuse .. "/.") .. " " .. files.quote(par.builddir))
  end, {correct_exit = 0})
  Make:latex_reused(latex)
else
  -- LaTeX writes the .aux of \include{dir/file} to dir in the build
  -- directory, and stops if dir does not exist. So each directory of the
  -- document is made there first, except hidden ones, build, links, and
  -- the build directory itself, which would otherwise be made inside itself
  -- on each run. Then the document's .aux, .xref, .4tc, and lists of an
  -- earlier build beside it are hidden, as described below.
  Make:add("folders", function(par)
    if par.builddir == "" then return 0 end
    local out = lfs.attributes(par.builddir)
    local function walk(dir)
      -- (lfs.dir raises an error on a folder that cannot be read, such as
      -- one a container left owned by root)
      local ok, names, state = pcall(lfs.dir, dir)
      if not ok then return end
      for name in names, state do
        local path = dir .. "/" .. name
        local attributes = lfs.symlinkattributes(path)
        if not name:find("^%.") and path ~= "./build" and attributes.mode == "directory"
          and not (attributes.ino == out.ino and attributes.dev == out.dev) then
          lfs.mkdir(par.builddir .. "/" .. path:sub(3))
          walk(path)
        end
      end
    end
    walk(".")
    -- (an empty .aux, .xref, and .4tc in the build directory, for each
    -- such file beside the document that the build directory lacks, so
    -- that the first LaTeX run does not read the one beside the document,
    -- as web2c's open_input looks there for a file missing in the build
    -- directory. Only for such a file: tex4ht.sty builds the table of
    -- contents from an empty .4tc and warns on an empty .xref, where a
    -- missing one gives neither. Not in draft mode, whose one LaTeX run
    -- takes its references from a current .aux beside the document, as
    -- pdflatex does)
    local here = lfs.attributes(".")
    if not (here.ino == out.ino and here.dev == out.dev) then
      if mode ~= "draft" then
        for _, extension in ipairs {"aux", "xref", "4tc"} do
          local name = par.input .. "." .. extension
          local file = par.builddir .. "/" .. name
          if lfs.attributes(name) and not lfs.attributes(file) then io.open(file, "w"):close() end
        end
      end
      -- (and for each list of an earlier build beside the document: a
      -- file named for the document whose extension is a list's, and not
      -- a file the document or a tool reads as its source, one that the
      -- other steps handle, or backref's .brf, whose current entries a
      -- draft build shows from its one LaTeX run, as pdflatex does. The
      -- \@starttoc of article.4ht reads each list other than the
      -- standard ones, which go through the .4ct, amsart's reads every
      -- list, and titletoc reads its partial lists with \@input, so a
      -- list under an extension the document chose, as with tocloft's
      -- \newlistof, is read from beside the document. A list may hold
      -- only \addtocontents writes, such as babel's \babel@toc, with a
      -- macro that this build does not define. The extension is a
      -- list's when:
      -- - it is one of the lists of LaTeX, titletoc, listings, and
      --   algorithm, or the .aux beside the document, or an .aux of an
      --   \include that it reads with \@input, names it in \@writefile;
      -- - it is one of minitoc's numbered lists, a name of the long or
      --   the shortext form followed by digits, such as .mtc1 or .M1.
      --   These hold minitoc's own lines, which need not have
      --   \contentsline, as for a coffee line, and no .aux names them;
      -- - the file has a line that starts with "\contentsline {", which
      --   LaTeX's \addcontentsline writes with a space after the
      --   command. Any line counts, as biblatex writes other lines
      --   before the entries;
      -- - or each of its lines starts with a command and a space, as
      --   \write gives them: a list of an extension the document chose,
      --   with no .aux beside. A file written by hand usually has no such
      --   space, as in "\newcommand{".
      -- Also in draft mode, as such a list may come from a build with
      -- other packages and stop its one LaTeX run. Its entries then show
      -- from the second draft build on, from the list that the first one
      -- wrote)
      local prefix = par.input .. "."
      local function set(words)
        local result = {}
        for word in words:gmatch("%S+") do result[word] = true end
        return result
      end
      local source = set("aux bbl ind gls brf ltx sty cls clo def fd cfg 4ht bbx cbx txt")
      local named = set("toc lof lot ptc plf plt lol loa")
      local numbered = set("mtc mlf mlt ptc plf plt stc slf slt M F T P G U S H V")
      local read = {}
      local function scan(name)
        if read[name] then return end
        read[name] = true
        local auxfile = io.open(name, "rb")
        if not auxfile then return end
        local text = auxfile:read("a")
        auxfile:close()
        for extension in text:gmatch("\\@writefile%s*{([^}]*)}") do named[extension] = true end
        for included in text:gmatch("\\@input%s*{([^}]*)}") do scan(included) end
      end
      scan(prefix .. "aux")
      local function list(name)
        local extension = name:sub(#prefix + 1)
        if source[extension] then return false end
        if named[extension] or numbered[extension:match("^(%a+)%d+$")] then return true end
        local file = io.open(name, "rb")
        if not file then return false end
        local written, lines = true, 0
        for line in file:lines() do
          if line:find("^\\contentsline {") then file:close() return true end
          if line:find("%S") then
            lines = lines + 1
            if not line:find("^\\[%a@]+ ") then written = false end
          end
        end
        file:close()
        return written and lines > 0
      end
      for name in lfs.dir(".") do
        local file = par.builddir .. "/" .. name
        if name:sub(1, #prefix) == prefix and name ~= par.tex_file and not name:find("%.tex$")
          and lfs.attributes(name, "mode") == "file" and not lfs.attributes(file) and list(name) then
          io.open(file, "w"):close()
        end
      end
    end
    return 0
  end)
  Make:folders {}
  -- The folders above, one a line, in <document>.texinputs in the build
  -- directory, where web2c's open_input looks first. (Not on LaTeX's
  -- command line, where a folder name with %, #, or ' stops the build.
  -- Without -B, nothing is written beside the document, and those folders
  -- count as TeX's.)
  Make:add("texinputs", function(par)
    if par.builddir == "" then return 0 end
    local name = par.builddir .. "/" .. par.input .. ".texinputs"
    if #owndirs == 0 then
      os.remove(name)
      return 0
    end
    local file = assert(io.open(name, "w"))
    file:write(table.concat(owndirs, "\n"), "\n")
    file:close()
    return 0
  end)
  Make:texinputs {}
  if save then
    Make:add("latex_begin", function() mark("begin") return 0 end)
    Make:latex_begin {}
  end
  -- LaTeX's first run reads the .bbl beside the document when the build
  -- directory has none, as pdflatex does there. That .bbl may come from an
  -- earlier build with another backend or style, and give LaTeX errors.
  -- Then the run is made again with an empty .bbl in the build directory,
  -- from the .aux, .xref, and .4tc it started with, as the first run's
  -- .aux may hold \bibcite lines that natbib rejects. Only the second
  -- run's errors are shown. bibtex or biber then write the right .bbl.
  -- The build directory's own .aux and .bbl may come from an earlier build
  -- that used biblatex when this one does not, or the other way, and give
  -- errors too. Then the run is made again with that .aux or .bbl empty.
  -- (The main .aux names the .aux of each \include'd file, which is read
  -- through it.)
  -- (An empty .bbl from the start would cost a current .bbl, which latexmk
  -- leaves after a PDF build, one more LaTeX run: its \bibcite lines would
  -- first reach the .aux in the second run. The error's file cannot tell
  -- whether the .bbl caused it: make4ht's log parser names the .aux or the
  -- config for biblatex's and natbib's errors. So a document with other
  -- errors runs twice here when a .bbl is beside it. Draft mode's one run
  -- reads the .bbl beside, as pdflatex does.)
  -- The first run also reads the sorted index or glossary file beside the
  -- document when the build directory has none, and makeindex and
  -- makeglossaries write that file only after the run. When the run gives
  -- errors, it is made again with an empty file of each such name in the
  -- build directory: the indexes that tex8web-hooks.sty records, the
  -- document's index when the run wrote its .idx, and, when the document
  -- has \makeglossaries, the glossaries' output files in the \@newglossary
  -- lines of the new .aux. Those names are known only after the run.
  -- (glossaries writes \@newglossary lines without \makeglossaries too,
  -- and \@istfilename only with it, as index.lua tests before it runs
  -- makeglossaries. A .idx in the build directory from an earlier build is
  -- removed before the run, so a .idx there is one this run wrote.)
  -- When makeindex or makeglossaries fails, the step "unsorted" removes
  -- each such file that the failed tool did not write, so the later runs,
  -- and the next build, read the file beside the document, as the PDF
  -- build does. (The empty file is dated 1970, and a write dates it now.
  -- makeindex writes an empty .ind for an index without entries.)
  local placeholders = {}
  Make:add("htlatex_first", function(par)
    local base = par.builddir .. "/" .. par.input
    -- (biblatex writes the .bcf in each run with biber. bibliography.lua
    -- runs biber for any .bcf, so one of an earlier build would have biber
    -- run for a document that no longer uses it.)
    os.remove(base .. ".bcf")
    local out, here = lfs.attributes(par.builddir), lfs.attributes(".")
    local separate = out and not (here.ino == out.ino and here.dev == out.dev)
    if separate then os.remove(base .. ".idx") end
    local beside = separate and lfs.attributes(par.input .. ".bbl") and not lfs.attributes(base .. ".bbl")
    local saved = {}
    for _, extension in ipairs {"aux", "xref", "4tc", "bbl"} do
      saved[extension] = files.read(base .. "." .. extension) or false
    end
    if mode == "draft" or not (separate or saved.aux or saved.bbl) then
      return htlatex.htlatex(par)
    end
    -- (htlatex.htlatex calls Make.testlogfile, which prints the log's
    -- errors, after the run)
    local testlogfile, errors = Make.testlogfile, 0
    Make.testlogfile = function(p)
      local content = files.read(p.builddir .. "/" .. p.input .. ".log") or ""
      if content:find("\n!") or content:find("[^:]+:%d+:.+") then errors = #errorlogparser.parse(content) end
      return 0
    end
    htlatex.htlatex(par)
    Make.testlogfile = testlogfile
    -- natbib writes \NAT@force@numbers to the .aux when the .bbl has an
    -- item without author-year data, and the next run raises an error for
    -- an author-year style (natbib.sty, \NAT@stdbsttrue). A .bbl that
    -- bibtex made with another style gives that line, with or without
    -- errors in this run, even when some of its items have author-year
    -- data. So the run is made again without that .bbl, when the style
    -- differs from the one of the earlier .blg.
    -- (A draft build writes the new style to the .aux and runs no bibtex.
    -- bibliography.lua gives bibtex a style name that begins with ./ or
    -- ../ from the current directory, which the .blg shows.)
    -- (\NAT@force@numbers and \bibstyle are in the .aux of the file that
    -- reads the .bbl or sets the style, which may be a file read by
    -- \include, with an .aux of its own.)
    local written = files.read(base .. ".aux") or ""
    local bib = written
    for _, part in ipairs(bibliography.parts(par.builddir, written)) do bib = bib .. part.text end
    local now = bib:match("\\bibstyle{([^}]*)}")
    local blg_style = (files.read(base .. ".blg") or ""):match("The style file: ([^\r\n]*)%.bst")
    local natbib = bib:find("\\NAT@force@numbers", 1, true) and saved.bbl and now and blg_style
      and blg_style ~= now and blg_style ~= lfs.currentdir() .. "/" .. now
    -- (When the build directory is the document's directory, its .bbl is
    -- the one beside the document. bibliography.lua skips bibtex when a
    -- .bib is missing, and LaTeX then reads that .bbl, as for the PDF.)
    if natbib and not beside and out and here.ino == out.ino and here.dev == out.dev then
      local names = {}
      for list in bib:gmatch("\\bibdata{([^}]*)}") do
        for name in list:gmatch("[^,]+") do
          names[#names + 1] = name:find("^%.%.?/") and lfs.currentdir() .. "/" .. name or name
        end
      end
      if bibliography.missing(names, par.builddir) then natbib = false end
    end
    if errors == 0 and not natbib then return testlogfile(par) end
    -- (biblatex writes \abx@aux@ lines to the .aux with any backend, and
    -- this line at the top of its .bbl)
    local biblatex = written:find("\\abx@aux@", 1, true) ~= nil
    local function stale(content, mark)
      return content and content ~= "" and (content:find(mark, 1, true) ~= nil) ~= biblatex
    end
    local aux, bbl = stale(saved.aux, "\\abx@aux@"), stale(saved.bbl, "% $ biblatex auxiliary file $")
    local sorted = {}
    if errors > 0 and separate then
      local names = {}
      for _, found in ipairs(index.indexes(written, par.input, lfs.attributes(base .. ".idx"))) do
        names[#names + 1] = found.name .. ".ind"
      end
      if written:find("\\@istfilename{", 1, true) then
        for extension in written:gmatch("\\@newglossary{[^}]*}{[^}]*}{([^}]*)}{[^}]*}") do
          names[#names + 1] = par.input .. "." .. extension
        end
      end
      local seen = {}
      for _, name in ipairs(names) do
        if not seen[name] and lfs.attributes(name) and not lfs.attributes(par.builddir .. "/" .. name) then
          sorted[#sorted + 1] = name
        end
        seen[name] = true
      end
    end
    if not (beside or aux or bbl or natbib or #sorted > 0) then return testlogfile(par) end
    if beside then
      log:status("the first LaTeX run gave errors and a .bbl is beside the document, so it runs again without that .bbl")
    elseif natbib then
      log:status("the first LaTeX run read a .bbl of another bibliography style, with items that have no author-year data for natbib, so it runs again without that .bbl")
    elseif aux or bbl then
      log:status("the first LaTeX run gave errors and the build directory has files of a build with another bibliography backend, so it runs again without them")
    end
    if #sorted > 0 then
      log:status("the first LaTeX run gave errors and sorted index or glossary files are beside the document, so it runs again without them: " .. table.concat(sorted, ", "))
    end
    saved.bbl = nil
    if aux then
      saved.aux = ""
    elseif natbib and saved.aux then
      local force = "\\providecommand\\NAT@force@numbers{}\\NAT@force@numbers\n?"
      saved.aux = saved.aux:gsub(force, "")
      -- (the .aux files of the files read by \include, which the run
      -- reads through saved.aux)
      for _, part in ipairs(bibliography.parts(par.builddir, saved.aux)) do
        local f = io.open(part.path, "w")
        f:write((part.text:gsub(force, "")))
        f:close()
      end
    end
    for extension, content in pairs(saved) do
      local path = base .. "." .. extension
      if content then
        local f = io.open(path, "w")
        f:write(content)
        f:close()
      else
        os.remove(path)
      end
    end
    if beside or bbl or natbib then io.open(base .. ".bbl", "w"):close() end
    for _, name in ipairs(sorted) do
      local path = par.builddir .. "/" .. name
      io.open(path, "w"):close()
      lfs.touch(path, 0, 0)
      placeholders[#placeholders + 1] = path
    end
    return htlatex.htlatex(par)
  end, {correct_exit = 0})
  Make:htlatex_first(latex)
  if mode ~= "draft" then
    Make:add("bibliography", bibliography.run)
    Make:bibliography {}
    Make:add("index", index.run)
    Make:index {}
    Make:add("glossaries", index.glossaries)
    Make:glossaries {}
    Make:add("unsorted", function()
      for _, path in ipairs(placeholders) do
        local found = lfs.attributes(path)
        if found and found.modification == 0 and found.size == 0 then os.remove(path) end
      end
      return 0
    end)
    Make:unsorted {}
    -- (make4ht's autohtlatex checks only the document's .aux, and not the
    -- .aux of a file read by \include)
    Make:add("settle", function(par) return bibliography.settle(par, index.again) end, {correct_exit = 0})
    Make:settle(latex)
    Make:add("glossaries_again", index.glossaries_again, {correct_exit = 0})
    Make:glossaries_again(latex)
  end
  if save then
    Make:add("latex_save", function(par)
      -- (texlua's os.execute returns the exit status, not Lua 5.3's true)
      local empty = lfs.attributes(save, "mode") == "directory"
      if empty then
        for name in lfs.dir(save) do
          if name ~= "." and name ~= ".." then empty = false end
        end
      end
      if empty and os.execute("cp -R " .. files.quote(par.builddir .. "/.") .. " " .. files.quote(save)) == 0 then
        mark("end")
      end
      return 0
    end)
    Make:latex_save {}
  end
end
-- tex4ht's font files for the fonts whose f-ligatures are in other slots
-- than their encoding's, for tex4ht, which runs after these commands
Make:add("htf", htf.write)
Make:htf {}
-- a picture that holds another picture made one picture, for tex4ht, and
-- in every picture, a lock of the bounding box inside another lock
-- dropped, for dvisvgm. A DVI copied back from TEX8WEB_LATEX_REUSE was
-- saved before this step, and is changed again.
Make:add("nested_pictures", dvi.nested_pictures)
Make:nested_pictures {}
-- (tex4ht's class files list \jobname.4idx among the page's files, for
-- tex4ht's index script: \warn:idx in article.4ht. make4ht never makes the
-- file, and copying it to -d logs an error.)
Make:match("4idx$", function() return false end)
-- (the .lg names a picture outside the document's folder by its ../ or
-- absolute path, and make4ht would append that path to -d: a ../ path goes
-- outside the page's folder, and an absolute one puts the writer's folders
-- in the page's folder. assets.copy copies it to tex8web-pictures instead.
-- Other files, such as stylesheets and fonts, are left to make4ht:
-- assets.lg_leaves.)
Make:match(".", function(filename, par)
  if assets.lg_leaves(filename, par.builddir) then
    return false, filename .. " is outside the document's folder"
  end
end)

-- Each pass is function(document, context). The order matters for:
-- - page.build_data: first, as it fills context and removes its scripts
-- - text.colors and text.pictures: before the passes that look at what
--   lies between elements, as their marks are elements until they are
--   removed
-- - make4ht's fixinlines: before page.controls puts the text in <main>, as
--   fixinlines looks only at the top level of the body
-- - page.equation_anchors: after fixinlines, which puts a loose anchor in
--   a paragraph
-- - text.line_comments: after the passes that look at what lies between
--   nodes, as LuaXML's remove_node leaves a placeholder among the parent's
--   children (luaxml-domobject.lua)
-- - assets.copy: last, as it reads the finished page
local passes = {
  page.build_data,
  text.colors,
  text.pictures,
  source.spaces,
  text.sized_math_spaces,
  text.dcolumn_spaces,
  text.block_spacing,
  text.box_theorems,
  text.heading_lists,
  text.same_page_links,
  text.label_space,
  text.hfill,
  text.cell_align,
  text.no_break_spaces,
  text.long_literals,
  text.literal_blocks,
  text.literal_sizes,
  text.boxed_listings,
  text.url_breaks,
  text.minipages,
  text.sidenotes,
  fixinlines,
  page.controls,
  page.toc_targets,
  page.equation_anchors,
  macros.define,
  page.permalinks,
  page.terms,
  page.meta_tags,
  page.scripts,
  text.line_comments,
  assets.inline_colors,
  assets.copy,
}

-- what the passes know about the page: tex8web's directory (root), the
-- page's directory (dir), the document's name (input) and file (tex_file),
-- the MathJax version, and what page.build_data and assets.copy add
local context
local fix_html = domfilter({function(document)
  for _, pass in ipairs(passes) do pass(document, context) end
  return document
end}, "tex8web")

local mathjax = prerender.mathjax_version(root)

Make:match("html$", function(filename, par)
  context = {root = root, dir = filename:match("^(.*)/") or ".", input = par.input,
    tex_file = par.tex_file, mathjax = mathjax}
  -- (before the passes, as assets.copy reads the fonts' faces from the
  -- stylesheet)
  assets.unsized_fonts(context)
  local status = fix_html(filename, par)
  assets.stylesheet(context)
  if not prerender.run(context, filename) then
    assets.add(root .. "/js/tex8web.js", context.dir .. "/tex8web.js")
    assets.originals(context)
    assets.drop_preloads(filename, context.roles)
  end
  return status
end)
