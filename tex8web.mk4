-- make4ht build file for tex8web: HTML that looks like the PDF, with MathJax
-- typesetting the math from its LaTeX source. Use with tex8web.cfg, or a
-- config that \inputs tex8web-core.tex:
--   make4ht -c path/to/tex8web.cfg -e path/to/tex8web.mk4 -B build/tex4ht -d build/html document.tex
-- Sets TeX's and Lua's search paths and the build steps, and runs the HTML
-- passes (lua/tex8web/) and prerendering (prerender.lua). See "How it works"
-- in CONTRIBUTING.md.
-- (make4ht runs this file from a string; settings.build_file is its path)
local root = settings.build_file:match("^(.*)[/\\]") or "."
-- (texlua's require does not search package.path, so a searcher for lua/
-- is added)
table.insert(package.searchers, 2, function(name)
  local path, message = package.searchpath(name, root .. "/lua/?.lua")
  if not path then return message end
  return loadfile(path), path
end)
os.setenv("TEXINPUTS", root .. "/tex:" .. (os.getenv("TEXINPUTS") or ""))

local domfilter = require "make4ht-domfilter"
local fixinlines = require "make4ht-fixinlines"
local assets = require "tex8web.assets"
local bibliography = require "tex8web.bibliography"
local files = require "tex8web.files"
local index = require "tex8web.index"
local macros = require "tex8web.macros"
local page = require "tex8web.page"
local prerender = require "tex8web.prerender"
local source = require "tex8web.source"
local text = require "tex8web.text"

-- LaTeX, with tex/tex8web-hooks.sty loaded before the preamble and tex4ht's
-- fn-in option, which keeps footnotes on the page (text.lua moves them
-- beside the text); then bibtex or biber, makeindex, and makeglossaries,
-- which make4ht does not run, if the document needs them; then LaTeX until
-- the cross-references settle, and makeglossaries and LaTeX while the
-- glossaries change. (The parameters extend settings, because
-- Make.params is still empty here.)
local latex = {packages = settings.packages .. "\\RequirePackage{tex8web-hooks}",
  tex4ht_sty_par = settings.tex4ht_sty_par .. ",fn-in"}
-- The tests' builds (test/lib/build.mjs) copy LaTeX's build directory to
-- TEX8WEB_LATEX_SAVE, a path that must not exist yet. When nothing LaTeX
-- reads has changed, they pass that copy as TEX8WEB_LATEX_REUSE, which is
-- copied back in place of running LaTeX if it holds the DVI. The marks
-- around LaTeX's part of the log let the tests save that part too.
local save, reuse = os.getenv("TEX8WEB_LATEX_SAVE"), os.getenv("TEX8WEB_LATEX_REUSE")
if reuse and not lfs.attributes(reuse .. "/" .. settings.input .. "." .. settings.dvi) then reuse = nil end
local function mark(name)
  io.stdout:flush()
  print("tex8web-latex-" .. name)
  io.stdout:flush()
end
if reuse then
  -- (given LaTeX's parameters, which make4ht keeps for the commands after
  -- it; correct_exit makes a failed tex4ht or t4ht fatal)
  Make:add("latex_reused", function(par)
    mark("begin")
    mark("end")
    return os.execute("cp -R " .. files.quote(reuse .. "/.") .. " " .. files.quote(par.builddir))
  end, {correct_exit = 0})
  Make:latex_reused(latex)
else
  if save then
    Make:add("latex_begin", function() mark("begin") return 0 end)
    Make:latex_begin {}
  end
  Make:htlatex(latex)
  if mode ~= "draft" then
    Make:add("bibliography", bibliography.run)
    Make:bibliography {}
    Make:add("index", index.run)
    Make:index {}
    Make:add("glossaries", index.glossaries)
    Make:glossaries {}
    Make:autohtlatex(latex)
    Make:add("glossaries_again", index.glossaries_again, {correct_exit = 0})
    Make:glossaries_again(latex)
  end
  if save then
    Make:add("latex_save", function(par)
      -- (texlua's os.execute returns the exit status, not Lua 5.3's true)
      if not lfs.attributes(save) and os.execute("cp -R " .. files.quote(par.builddir) .. " " .. files.quote(save)) == 0 then
        mark("end")
      end
      return 0
    end)
    Make:latex_save {}
  end
end
-- (tex4ht's class files list \jobname.4idx among the page's files, for
-- tex4ht's index script: \warn:idx in article.4ht. make4ht never makes the
-- file, and copying it to -d logs an error.)
Make:match("4idx$", function() return false end)

-- Each pass is function(document, context). The order matters for:
-- - page.build_data: first, as it fills context and removes its scripts
-- - text.colors and text.pictures: before the passes that look at what
--   lies between elements, as their marks are elements until they are
--   removed
-- - make4ht's fixinlines: before page.controls puts the text in <main>, as
--   fixinlines looks only at the top level of the body
-- - page.equation_anchors: after fixinlines, which puts a loose anchor in
--   a paragraph
-- - text.line_comments: after the passes that look at what lies between
--   nodes, as LuaXML's remove_node leaves a placeholder among the parent's
--   children (luaxml-domobject.lua)
-- - assets.copy: last, as it reads the finished page
local passes = {
  page.build_data,
  text.colors,
  text.pictures,
  source.spaces,
  text.sized_math_spaces,
  text.block_spacing,
  text.box_theorems,
  text.heading_lists,
  text.same_page_links,
  text.label_space,
  text.hfill,
  text.cell_align,
  text.no_break_spaces,
  text.url_breaks,
  text.minipages,
  text.sidenotes,
  fixinlines,
  page.controls,
  page.toc_targets,
  page.equation_anchors,
  macros.define,
  page.permalinks,
  page.terms,
  page.meta_tags,
  page.scripts,
  text.line_comments,
  assets.inline_colors,
  assets.copy,
}

-- what the passes know about the page: tex8web's directory (root), the
-- page's directory (dir), the document's name (input) and file (tex_file),
-- the MathJax version, and what page.build_data and assets.copy add
local context
local fix_html = domfilter({function(document)
  for _, pass in ipairs(passes) do pass(document, context) end
  return document
end}, "tex8web")

local mathjax = prerender.mathjax_version(root)

Make:match("html$", function(filename, par)
  context = {root = root, dir = filename:match("^(.*)/") or ".", input = par.input,
    tex_file = par.tex_file, mathjax = mathjax}
  local status = fix_html(filename, par)
  assets.stylesheet(context)
  if not prerender.run(context, filename) then
    assets.add(root .. "/js/tex8web.js", context.dir .. "/tex8web.js")
    assets.originals(context)
    assets.drop_preloads(filename, context.roles)
  end
  return status
end)
