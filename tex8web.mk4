-- make4ht build file for tex8web: HTML that looks like the PDF, with MathJax
-- typesetting the math from its LaTeX source. Use with tex8web.cfg (or a
-- config of your own that \input's tex8web-core.tex):
--   make4ht -c path/to/tex8web.cfg -e path/to/tex8web.mk4 -B build -d out document.tex
-- It puts this directory on TeX's and Lua's search paths, runs bibtex or
-- biber when the document has a bibliography, runs the HTML passes
-- (lua/tex8web/), copies the files the page needs next to it, and typesets
-- the math with MathJax in Node, if it can (prerender.lua).
-- (make4ht runs this file from a string; settings.build_file is its path)
local root = settings.build_file:match("^(.*)[/\\]") or "."
-- (texlua's require doesn't look at package.path; add a searcher that does
-- the same for lua/)
table.insert(package.searchers, 2, function(name)
  local path, message = package.searchpath(name, root .. "/lua/?.lua")
  if not path then return message end
  return loadfile(path), path
end)
os.setenv("TEXINPUTS", root .. "/tex:" .. (os.getenv("TEXINPUTS") or ""))

local domfilter = require "make4ht-domfilter"
local assets = require "tex8web.assets"
local bibliography = require "tex8web.bibliography"
local macros = require "tex8web.macros"
local page = require "tex8web.page"
local prerender = require "tex8web.prerender"
local source = require "tex8web.source"
local text = require "tex8web.text"

-- LaTeX, with tex/tex8web-hooks.sty loaded before the preamble; then the
-- bibliography, if the document has one, which make4ht doesn't run itself;
-- and LaTeX until the cross-references settle
local latex = {packages = (Make.params.packages or "") .. "\\RequirePackage{tex8web-hooks}"}
if mode == "draft" then
  Make:htlatex(latex)
else
  Make:htlatex(latex)
  Make:add("bibliography", bibliography.run)
  Make:bibliography {}
  Make:autohtlatex(latex)
end

-- each pass is function(document, context), in this order
local passes = {
  page.build_data,
  source.spaces,
  macros.define,
  text.theorem_spacing,
  text.no_break_spaces,
  page.controls,
  page.permalinks,
  page.meta_tags,
  page.scripts,
  assets.copy,
}

-- what the passes know about the page: tex8web's directory (root), the
-- page's (dir), the document's name (input) and file (tex_file), the
-- MathJax version; and what page.build_data adds
local context
local fix_html = domfilter({function(document)
  for _, pass in ipairs(passes) do pass(document, context) end
  return document
end}, "tex8web")

local mathjax = prerender.mathjax_version(root)

Make:match("html$", function(filename, par)
  context = {root = root, dir = filename:match("^(.*)/") or ".", input = par.input,
    tex_file = par.tex_file, mathjax = mathjax}
  local status = fix_html(filename, par)
  assets.stylesheet(context)
  if not prerender.run(context, filename) then
    assets.add(root .. "/js/tex8web.js", context.dir .. "/tex8web.js")
  end
  return status
end)
