-- make4ht build file for HTML that looks like the PDF, with MathJax
-- typesetting the math from its LaTeX source. Use with web.cfg (or a config
-- of your own that \input's web-core.tex):
--   make4ht -c path/to/web.cfg -e path/to/web.mk4 document.tex
-- It puts this directory on TeX's and Lua's search paths, copies the Latin
-- Modern fonts (fonts/) and the document's images next to the HTML, and
-- gives MathJax the document's macros. With node_modules installed (npm ci
-- here), prerender.mjs then typesets the math; otherwise the page loads
-- MathJax, with web.js next to it.
-- (make4ht runs this file from a string; settings.build_file is its path)
local root = settings.build_file:match("^(.*)[/\\]") or "."
-- (texlua's require doesn't look at package.path; add a searcher that does
-- the same for lua/)
table.insert(package.searchers, 2, function(name)
  local path, message = package.searchpath(name, root .. "/lua/?.lua")
  if not path then return message end
  return loadfile(path), path
end)
os.setenv("TEXINPUTS", root .. "/tex:" .. (os.getenv("TEXINPUTS") or ""))

local domfilter = require "make4ht-domfilter"
local log = logging.new("web")
local macros = require "web.macros"
local source = require "web.source"
local text = require "web.text"

local passes = {
  source.spaces,
  macros.define,
  text.theorem_spacing,
  text.no_break_spaces,
}

local fix_html = domfilter({function(document, par)
  for _, pass in ipairs(passes) do pass(document, par) end
  return document
end}, "web")

local fonts = {
  "lmroman10-regular.woff2",
  "lmroman10-bold.woff2",
  "lmroman10-italic.woff2",
  "lmroman10-bolditalic.woff2",
  "lmmono10-regular.woff2",
}

local function exists(path)
  return lfs.attributes(path) ~= nil
end

-- copies a file into the output, and lists it with tex4ht's output files,
-- so make4ht -d copies it too
local function add(source, path)
  copy(source, path)
  Make:add_file(path)
end

local function quote(s)
  return "'" .. s:gsub("'", "'\\''") .. "'"
end

-- typesets the page's math with MathJax in Node (prerender.mjs), when its
-- node_modules is installed; otherwise MathJax does it in the browser
local function prerender(filename)
  if not exists(root .. "/node_modules/mathjax") then
    log:info("math left for MathJax in the browser; run npm ci in " .. root
      .. " to typeset it here")
    return false
  end
  local node = io.popen("node " .. quote(root .. "/prerender.mjs") .. " " .. quote(filename))
  -- (it prints the files it made: MathJax's styles and fonts)
  local files = {}
  for path in node:lines() do files[#files + 1] = path end
  if not node:close() then
    log:warning("prerender.mjs failed; math left for MathJax in the browser")
    return false
  end
  for _, path in ipairs(files) do Make:add_file(path) end
  return true
end

Make:match("html$", function(filename, par)
  local dir = filename:match("^(.*)/") or "."
  for _, font in ipairs(fonts) do
    add(root .. "/fonts/" .. font, dir .. "/fonts/" .. font)
  end
  -- images from \includegraphics, which the HTML references relative to the
  -- source
  local f = io.open(filename)
  local html = f:read("*a")
  f:close()
  for src in html:gmatch("<img [^>]-src=['\"]([^'\"]+)['\"]") do
    if not src:match("^%a+:") and not exists(dir .. "/" .. src) and exists(src) then
      add(src, dir .. "/" .. src)
    end
  end
  local status = fix_html(filename, par)
  if not prerender(filename) then
    add(root .. "/js/web.js", dir .. "/web.js")
  end
  return status
end)
