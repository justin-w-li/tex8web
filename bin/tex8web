#!/bin/sh
# Builds a LaTeX document's web page:
#   tex8web [-c config] [-d out] [-B aux] [-p pdf] [-u url] [make4ht options] document.tex
#   tex8web --version
# The page goes to out (default: build/html beside the document), and
# tex4ht's files to aux, relative to the document (default: build/tex4ht).
# make4ht reads -B as a Lua pattern, so a - in an absolute path breaks it.
# -p links the page to the PDF, as \WebPDF does, and -u to the page above,
# as \WebUp does, through TEX8WEB_PDF and TEX8WEB_UP. make4ht runs in the
# document's directory, where pictures, \WebPDF, and the bibliography are
# found.
set -e
# (only -p and -u set these, so a value left in the shell links nothing
# stale)
unset CDPATH TEX8WEB_PDF TEX8WEB_UP

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)

absolute() { case $1 in /*) printf '%s\n' "$1" ;; *) printf '%s\n' "$PWD/$1" ;; esac; }
usage="usage: tex8web [-c config] [-d out] [-B aux] [-p pdf] [-u url] [make4ht options] document.tex
       tex8web --version"

if [ "$1" = --version ]; then
  version=$(sed -n 's/^  "version": "\(.*\)",$/\1/p' "$root/package.json")
  # (tex8web's .git, which is a file in a worktree, not that of a
  # repository tex8web was copied into)
  if [ -e "$root/.git" ] &&
    commit=$(git -C "$root" rev-parse --short HEAD 2>/dev/null); then
    # (uncommitted changes: not that commit)
    git -C "$root" diff --quiet HEAD 2>/dev/null || commit=$commit-dirty
    echo "tex8web $version ($commit)"
  else
    echo "tex8web $version"
  fi
  exit 0
fi

config=$root/tex8web.cfg out=build/html aux=build/tex4ht document=
count=$#
while [ "$count" -gt 0 ]; do
  arg=$1; shift; count=$((count - 1))
  case $arg in
    -c|-d|-B|-p|-u)
      [ "$count" -gt 0 ] || { echo "$usage" >&2; exit 2; }
      value=$1; shift; count=$((count - 1))
      case $arg in
        -c) config=$(absolute "$value") ;;
        -d) out=$(absolute "$value") ;;
        -B) aux=$value ;;
        -p) TEX8WEB_PDF=$(absolute "$value"); export TEX8WEB_PDF ;;
        -u) TEX8WEB_UP=$value; export TEX8WEB_UP ;;
      esac ;;
    *)
      # the last argument is the document; the others go to make4ht
      if [ "$count" -eq 0 ]; then document=$arg; else set -- "$@" "$arg"; fi ;;
  esac
done
[ -f "$document" ] || { echo "$usage" >&2; exit 2; }
[ -z "$TEX8WEB_PDF" ] || [ -f "$TEX8WEB_PDF" ] ||
  { echo "tex8web: no PDF at $TEX8WEB_PDF; build it first" >&2; exit 2; }
# (a file that the config \inputs is found beside the config, after the
# document's directory and TeX's tree, where an empty entry puts these, so
# that a file the document reads is the one its PDF reads)
TEXINPUTS=${TEXINPUTS-}:$(dirname "$config"); export TEXINPUTS

cd "$(dirname "$document")"
# (tex4ht splits the config's path at spaces and commas, TeX reads a
# percent sign, #, backslash, caret, brace, tilde, or byte above 127 in it,
# and an apostrophe ends make4ht's quoting of it. So a config whose path
# has any character outside a short safe list, as tex8web.cfg has when
# tex8web is in such a folder, is read from a copy in build/ beside the
# document, by a relative path, which keeps to the list whatever -B is.
# The copy is named after the document, with the same safe characters and
# a checksum of the document's name, -B, and the config's path, as builds
# in one folder share build/ and make4ht reads the config on each run. It
# is written to a temporary file and moved into place, so a build reading
# the copy never sees it part-written. LC_ALL=C compares bytes, as a
# bracket range follows the locale otherwise.)
if printf '%s\n' "$config" | LC_ALL=C grep -q '[^A-Za-z0-9/._+-]'; then
  name=$(basename "$document" .tex)
  copy=build/tex8web-$(printf %s "$name" | LC_ALL=C tr -c 'A-Za-z0-9._-' _)-$(printf '%s\n' "$name" "$aux" "$config" | cksum | cut -d ' ' -f 1).cfg
  mkdir -p build; cp "$config" "$copy.$$"; mv -f "$copy.$$" "$copy"; config=$copy
fi
# (make4ht and its LaTeX command line take the build folder unquoted, in
# make4ht-htlatex.lua (--output-directory=${builddir}) and mkutils.lua
# (-auxdir=${builddir}), so a build folder whose path has a space is
# reached through a link without one, made for this run in build/ beside
# the document and removed when it ends. The link's name has the host's
# name and the process ID, as builds in containers that share build/ have
# the same process IDs. A link that a killed run on this host left is
# removed once its process is gone, and a name already taken stops the
# build. A build/ that holds nothing but such links when the run starts,
# or that is missing, is removed when the run ends if it is empty then, so
# that a build folder outside build/ leaves nothing beside the document
# when builds overlap; a run that started at the same time makes it again
# before its link.)
link= made=
case $aux in *" "*)
  made=1
  for entry in build/* build/.[!.]* build/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    case $entry in build/tex8web_aux_*) [ -L "$entry" ] && continue ;; esac
    made=; break
  done
  mkdir -p build
  host=$(uname -n | tr -c 'A-Za-z0-9\n' _)
  for stale in build/tex8web_aux_"$host"_*; do
    # (the glob also matches the links of a host whose name starts with
    # this one's and an underscore; their part after the prefix is not a
    # process ID alone)
    pid=${stale#build/tex8web_aux_"$host"_}
    case $pid in *[!0-9]*|'') continue ;; esac
    [ -L "$stale" ] && { [ "$pid" = $$ ] || ! kill -0 "$pid" 2>/dev/null; } && rm -f "$stale"
  done
  mkdir -p "$aux"
  link=build/tex8web_aux_${host}_$$ target=$(absolute "$aux")
  if [ -e "$link" ] || [ -L "$link" ]; then echo "tex8web: $link exists" >&2; exit 1; fi
  ln -s "$target" "$link" 2>/dev/null || { [ -d build ] || made=1; mkdir -p build; ln -s "$target" "$link"; }
  child=
  trap 'rm -f "$link"; [ -z "$made" ] || rmdir build 2>/dev/null || :' EXIT
  for signal in HUP:129 INT:130 TERM:143; do
    trap '[ -z "$child" ] || kill "$child" 2>/dev/null; exit '"${signal#*:}" "${signal%:*}"
  done
  aux=$link ;;
esac
set -- make4ht -u -c "$config" -e "$root/tex8web.mk4" -B "$aux" -d "$out" "$@" "$(basename "$document")"
[ -n "$link" ] || exec "$@"
# (with a link, make4ht runs as a child, so that the link is removed when
# make4ht ends. sh runs a trap only once the command it waits for has
# ended, so make4ht runs in the background, with the input kept, and the
# traps stop it. sh starts a background command with INT and QUIT
# ignored, which LaTeX would keep after a Ctrl-C; perl, which TeX Live
# needs, restores them)
perl -e '$SIG{INT} = $SIG{QUIT} = "DEFAULT"; exec @ARGV or die "tex8web: $ARGV[0]: $!\n"' "$@" <&0 &
child=$!
wait "$child"
