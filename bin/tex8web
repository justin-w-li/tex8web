#!/bin/sh
# Builds a LaTeX document's web page with tex8web:
#   tex8web [-c config] [-d out] [-B aux] [-p pdf] [make4ht options] document.tex
# The page goes to out (default: build/html beside the document) and
# tex4ht's files to aux, relative to the document (default: build/tex4ht).
# -p links the page to the document's PDF, as \WebPDF does, through
# TEX8WEB_PDF.
# make4ht reads -B as a Lua pattern, so a - in an absolute path breaks it.
# make4ht runs in the document's directory, where its pictures, \WebPDF
# and bibliography are found.
set -e
# (only -p sets TEX8WEB_PDF, so that one left in the shell links no stale PDF)
unset CDPATH TEX8WEB_PDF

self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in /*) self=$link ;; *) self=$(dirname "$self")/$link ;; esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)

absolute() { case $1 in /*) printf '%s\n' "$1" ;; *) printf '%s\n' "$PWD/$1" ;; esac; }
usage="usage: tex8web [-c config] [-d out] [-B aux] [-p pdf] [make4ht options] document.tex"

config=$root/tex8web.cfg out=build/html aux=build/tex4ht document=
count=$#
while [ "$count" -gt 0 ]; do
  arg=$1; shift; count=$((count - 1))
  case $arg in
    -c|-d|-B|-p)
      [ "$count" -gt 0 ] || { echo "$usage" >&2; exit 2; }
      value=$1; shift; count=$((count - 1))
      case $arg in
        -c) config=$(absolute "$value") ;;
        -d) out=$(absolute "$value") ;;
        -B) aux=$value ;;
        -p) TEX8WEB_PDF=$(absolute "$value"); export TEX8WEB_PDF ;;
      esac ;;
    *)
      # the last argument is the document; the others go to make4ht
      if [ "$count" -eq 0 ]; then document=$arg; else set -- "$@" "$arg"; fi ;;
  esac
done
[ -f "$document" ] || { echo "$usage" >&2; exit 2; }
[ -z "$TEX8WEB_PDF" ] || [ -f "$TEX8WEB_PDF" ] ||
  { echo "tex8web: no PDF at $TEX8WEB_PDF; build it first" >&2; exit 2; }
# (tex4ht takes the config's path apart at spaces, and the default config
# is in tex8web's directory)
case $config in *" "*)
  echo "tex8web: tex4ht can't read a config whose path has a space: $config" >&2; exit 2 ;;
esac

cd "$(dirname "$document")"
exec make4ht -u -c "$config" -e "$root/tex8web.mk4" -B "$aux" -d "$out" "$@" "$(basename "$document")"
