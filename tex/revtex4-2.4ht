% tex4ht has revtex4.4ht and no file for revtex4-2, whose headings,
% title, and floats are revtex4's. Without this file the headings are
% bold text in one paragraph. tex4ht reads <class>.4ht from tex8web's
% tex/, which tex8web.mk4 puts on TEXINPUTS.
\input revtex4.4ht
% revtex4.4ht's title block restores \@makefnmark@latex and
% \@footnotemark@latex, which revtex4.cls saves as the document starts and
% revtex4-2 does not, and counts the title's notes as footnotes. revtex4-2
% counts them as mpfootnotes, so the body's footnotes start at 1.
\appdef\class@documenthook{%
 \let\@makefnmark@latex\@makefnmark
 \let\@footnotemark@latex\@footnotemark}
\pend:def\frontmatter@setup{\ltx@footnote@pop
 \def\@mpfn{mpfootnote}\def\thempfn{\thempfootnote}\c@mpfootnote\z@
 \web@revfntext}
% The mark of a \footnote in the title block links to the anchor that
% hyperref writes with the note's text, which tex4ht's text leaves out.
% The class names that anchor, and links to it, without hyperref too,
% where its \hyper@anchorstart writes nothing, so tex4ht's \Link writes
% the anchors of the title block's notes.
\def\web@revanchor#1{\Link{}{#1}\EndLink}
\def\web@revfntext{%
 \let\web@revfootnotetext\@footnotetext
 \long\def\@footnotetext##1{\web@revfootnotetext{%
   \ifdefined\Hy@footnote@currentHref
     \web@revanchor{\Hy@footnote@currentHref}\fi##1}}}
% The note's anchor is named as revtex4-2's marks link to it, from the
% mpfootnote count.
\long\def\frontmatter@makefntext#1{%
 \parindent 1em
 \c:frontpagefootnote \a:footnotetext
 \noindent
 \web@revanchor{frontmatter.\expandafter\the\csname c@\@mpfn\endcsname}%
 \@makefnmark
 \b:footnotetext \a:footnotebody
 #1%
 \b:footnotebody \c:footnotetext \d:frontpagefootnote
}
% latex.4ht's \thanks, set after the class's, writes a mark where it
% stands and keeps the note for LaTeX's \maketitle, which revtex4-2 does
% not use. revtex4-2's \thanks adds a note to the title block, as
% \email does.
\let\thanks\frontmatter@thanks
% aps marks the title's notes with footnote symbols in math, whose
% \ifcase would reach MathJax as it is, so they are set as text, with the
% 15 symbols of aps4-2.rtx. The other societies set \@fnsymbol to \@alph.
\def\frontmatter@thefootnote{%
 \altaffilletter@sw{\@alph}{\ifx\@fnsymbol\@alph
   \expandafter\@alph\else\expandafter\web@revfnsymbol\fi}%
 {\csname c@\@mpfn\endcsname}}
\def\web@revfnsymbol#1{\ifcase#1\or *\or \textdagger\or \textdaggerdbl\or
 \textsection\or \textparagraph\or **\or \textdagger\textdagger\or
 \textdaggerdbl\textdaggerdbl\or \textsection\textsection\or
 \textparagraph\textparagraph\or ***\or
 \textdagger\textdagger\textdagger\or
 \textdaggerdbl\textdaggerdbl\textdaggerdbl\or
 \textsection\textsection\textsection\or
 \textparagraph\textparagraph\textparagraph\else\@ctrerr\fi}
% The prl and aapm options put the title's notes in the references.
% Their anchors are written with \Hy@raisedlink and \hyper@anchorstart,
% which write nothing without hyperref, so tex4ht's \Link writes them.
% The label is set by \item before the text starts.
\let\web@revbibnote\present@bibnote
\def\present@bibnote#1#2{%
 \let\web@revraisedlink\Hy@raisedlink
 \let\web@revanchorstart\hyper@anchorstart
 \let\web@revanchorend\hyper@anchorend
 \let\Hy@raisedlink\@firstofone
 \let\hyper@anchorstart\web@revanchor \let\hyper@anchorend\relax
 \web@revbibnote{#1}{\let\Hy@raisedlink\web@revraisedlink
   \let\hyper@anchorstart\web@revanchorstart
   \let\hyper@anchorend\web@revanchorend #2}}
% revtex4-2 adds contents lines for the title and the abstract, which
% revtex4.4ht does not configure: each repeats the anchor of the line
% before it in the page.
\def\addcontents@abstract{}
\pend:def\frontmatter@title@produce{\let\addcontentsline\@gobblethree}
% prl's acknowledgments have no heading, and their contents line writes
% the anchor that the references' line after them writes again.
\pend:def\acknowledgments{\acknowledgments@sw{}{\let\addcontentsline\@gobblethree}}
% revtex4.4ht's title block shows the PACS numbers and the keywords
% whenever showpacs and showkeys are on, where revtex4-2's shows each
% only when the paper gives it, so a paper with none shows a lone
% "Keywords:" line. The title block's group turns each option off when
% its list is empty, after the abstract and before revtex4.4ht's test.
\append:def\frontmatter@abstract@produce{%
 \@ifx@empty\@pacs{\@booleanfalse\showPACS@sw}{}%
 \@ifx@empty\@keywords{\@booleanfalse\showKEYS@sw}{}}
% revtex4.4ht sets the page in one column, but the reprint and twocolumn
% options choose the two-column grid's \close@column as the class loads.
% Its \onecolumngrid at the end of the document writes a paragraph after
% </html>, so the one-column \close@column of revtex4-2.cls is restored.
\def\close@column{\newpage}
% revtex4-2's \appendix* sets \thesection to \unskip, which tex4ht writes
% into the anchor of the section that follows, and the next run stops on
% it. The section is left without a number, and its heading starts with
% "Appendix:", as in the PDF, unless the document numbers no section, as
% prl does: html4.4ht's test of secnumdepth is kept. A section with no
% title gets "Appendix" with no colon, as aps4-2's \@hangfrom@appendix
% gives.
\let\web@revappendix\appendix
\def\appendix{\@ifstar{\web@revappendix*\def\thesection{}%
    \ifx\section\web@revappsection\else
      \let\web@revsection\section \let\section\web@revappsection\fi
    \ConfigureMark{section}{\ifnum\c:secnumdepth>\c@secnumdepth
        \expandafter\:gobble
      \else\HCode{<span class="titlemark">}\appendixname
        \web@revappcolon\HCode{</span>}\fi}}%
  \web@revappendix}
\def\web@revappsection{\@ifstar{\web@revsection*}%
  {\@ifnextchar[\web@revappopt\web@revappplain}}
\def\web@revappplain#1{\web@revappmark{#1}\web@revsection{#1}}
\def\web@revappopt[#1]#2{\web@revappmark{#2}\web@revsection[{#1}]{#2}}
\def\web@revappmark#1{\def\web@revappcolon{#1}%
  \ifx\web@revappcolon\@empty\else\def\web@revappcolon{:}\fi}
% aps and prl draw a tapered rule in place of the references' heading
% (\bib@device), whose leaders tex4ht writes as underscores, a line that
% does not wrap. The rule is written as a \rule of the device's width,
% centered, which the stylesheet keeps within the column. The device's
% contents line stays. The center environment would start the list's
% first item, so its markup is written as html4.4ht writes it.
\def\web@revbibdevice#1#2{\par\IgnorePar\EndP
  \HCode{<div class="center">}\ShowPar\endgraf\noindent\phantomsection
  \addcontentsline{toc}{section}{\protect\numberline{}\refname}%
  \rule[-.5\p@]{#2}{\p@}\par\IgnorePar\EndP\HCode{</div>}\ShowPar}
\appdef\class@documenthook{%
  \ifdefined\bib@device \let\bib@device\web@revbibdevice \fi}
% html4.4ht's bibliography list ends each label with three no-break
% spaces, which make4ht joins into one span when the bibliography is in
% the body's font, as aapm's is. The PDF sets \labelsep after the label,
% nearer one space than three. \begin has set up the list
% (\this:listConfigure) before \thebibliography starts.
\ExplSyntaxOn
\pend:defI\thebibliography{%
  \regex_replace_all:nnN {\c{:nbsp}\c{:nbsp}\c{:nbsp}} {\c{:nbsp}} \this:listConfigure}
\ExplSyntaxOff
