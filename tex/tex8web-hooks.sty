% tex8web: records of the preamble settings that tex4ht discards, and
% \web@needs for every module. tex8web.mk4 loads this package with tex4ht,
% before the preamble. The rest of tex8web is read after \begin{document}
% (tex8web-core.tex).
\ProvidesPackage{tex8web-hooks}

% titlesec: tex4ht makes \titleformat do nothing and draws headings its own
% way. Each heading's format (font and alignment), shape, label, and space
% after the label are kept for tex8web-page.tex and tex8web-text.tex, as
% \web@titlefont@<name>, \web@titleshape@<name>, \web@titlelabel@<name>,
% and \web@titlesep@<name>. The shapes display and frame put the space
% elsewhere, so it is not kept for them.
\AddToHook{package/titlesec/after}{%
    \let\web@titleformat\titleformat
    \def\titleformat{\@ifstar\web@titleformat@s\web@titleformat@i}%
}
\def\web@titleformat@s#1#2{%
    \web@titlenote{font}{#1}{#2}%
    \web@titleformat*{#1}{#2}%
}
\def\web@titleformat@i#1{%
    \@ifnextchar[{\web@titleformat@ii{#1}}{\web@titleformat@ii{#1}[hang]}%
}
\def\web@titleformat@ii#1[#2]#3#4#5{%
    \web@titlenote{font}{#1}{#3}%
    \web@titlenote{shape}{#1}{#2}%
    \web@unlesshash{#4}{\web@titlenote{label}{#1}{#4}%
        \in@{,#2,}{,display,frame,}\ifin@\else\web@titlenote{sep}{#1}{#5}\fi}%
    \web@titleformat{#1}[#2]{#3}{#4}{#5}%
}
% only for a heading named by one command, \section. titlesec's key form,
% name=\section, is not handled.
\def\web@titlenote#1#2#3{%
    \if\relax\detokenize\expandafter{\@gobble#2}\relax
        \expandafter\gdef\csname web@title#1@\expandafter\@gobble\string#2\endcsname{#3}%
    \fi
}
% #2 unless #1 holds a #. A # stands for the title, which only titlesec's
% heading code fills in (option explicit).
\ExplSyntaxOn
\cs_new:Npn \web@unlesshash #1#2 { \str_if_in:nnF {#1} { \c_hash_str } {#2} }
\ExplSyntaxOff

% tcolorbox: the options whose effect cannot be read from a box as tex4ht
% draws it (tex8web-boxes.tex), recorded as they are set, from the preamble
% on: a hidden frame or interior, the space before and after, and the
% title's place. A box inside another starts again from tcolorbox's
% defaults (\tcb@reset), and so do these records. Once set, frame hidden
% and interior hidden stay for the box: a later option cannot clear them.
\def\web@tcb@reset{%
    \let\web@tcb@framehidden\relax
    \let\web@tcb@interiorhidden\relax
    \let\web@tcb@before\relax
    \let\web@tcb@after\relax
    \let\web@tcb@boxed\relax % a boxed title's place: left, center, or right
    \let\web@tcb@inline\relax % the title starts the text
}
% runs #2 when option #1 is set. Each option is hooked once, as soon as
% tcolorbox or one of its libraries defines it.
\def\web@tcb@note#1#2{%
    \pgfkeysifdefined{/tcb/#1/.@cmd}{\pgfkeysifdefined{/tcb/#1/web@noted}{}{%
        \pgfkeyssetvalue{/tcb/#1/web@noted}{}%
        \tcbset{#1/.append code={#2}}}}{}%
}
\def\web@tcb@notes{%
    \web@tcb@note{frame hidden}{\let\web@tcb@framehidden\@empty}%
    \web@tcb@note{interior hidden}{\let\web@tcb@interiorhidden\@empty}%
    \web@tcb@note{before skip}{\def\web@tcb@before{##1}}%
    \web@tcb@note{after skip}{\def\web@tcb@after{##1}}%
    \web@tcb@note{before skip balanced}{\def\web@tcb@before{##1}}%
    \web@tcb@note{after skip balanced}{\def\web@tcb@after{##1}}%
    \web@tcb@note{attach title to upper}{\let\web@tcb@inline\@empty}%
    \web@tcb@note{attach boxed title to top left}{\def\web@tcb@boxed{left}}%
    \web@tcb@note{attach boxed title to top text left}{\def\web@tcb@boxed{left}}%
    \web@tcb@note{attach boxed title to top center}{\def\web@tcb@boxed{center}}%
    \web@tcb@note{attach boxed title to top text right}{\def\web@tcb@boxed{right}}%
    \web@tcb@note{attach boxed title to top right}{\def\web@tcb@boxed{right}}%
}
\def\web@tcb@install{%
    \web@needs{tcb@reset}%
    \web@needs{tcb@load@library}%
    \web@tcb@reset
    \preto\tcb@reset{\web@tcb@reset}%
    \web@tcb@notes
    \let\web@tcb@load@library\tcb@load@library
    \def\tcb@load@library##1##2{\web@tcb@load@library{##1}{##2}\web@tcb@notes}%
}
\AddToHook{package/tcolorbox/after}{\web@tcb@install}

% imakeidx: under tex4ht, imakeidx runs no index program (imakeidx-hooks.4ht
% passes it noautomatic). It still calls \imki@finalmessage for each index
% that \printindex prints, with the program and options set. The command
% it would run is written to the .aux as a comment, for index.lua. The hook
% runs after the option quiet, which sets \imki@finalmessage to \@gobble.
\AddToHook{package/imakeidx/after}{%
    \web@needs{imki@finalmessage}%
    \def\imki@finalmessage#1{\immediate\write\@auxout{\@percentchar\space
        tex8web index: \imki@program\imki@options#1.idx}}%
}

% hyperref's hidelinks, under which tex8web-page.tex leaves links unmarked:
% as a package option, or later in \hypersetup (kvoptions'
% \KV@Hyp@hidelinks). The link colors and \@pdfborder cannot show it,
% since they are the same without it.
\AddToHook{package/hyperref/after}{%
    \@ifpackagewith{hyperref}{hidelinks}{\gdef\web@hidelinks{}}{}%
    \expandafter\let\expandafter\web@hidelinks@kv\csname KV@Hyp@hidelinks\endcsname
    \expandafter\def\csname KV@Hyp@hidelinks\endcsname{\gdef\web@hidelinks{}\web@hidelinks@kv}%
}

% \@title before any \title, which is the kernel's error. tex8web-text.tex
% compares \@title with it to tell whether the document has a title.
\let\web@notitle\@title

% \web@needs{name}: a warning unless \<name>, which tex8web patches or
% calls, is defined. npm test fails on the warning, so a tex4ht or package
% release that drops the command shows in the tests instead of as a wrong
% page. The argument is a name so that tex4ht's commands, such as
% :tableofcontents, can be given.
\def\web@needs#1{\ifcsname#1\endcsname\else\web@outdated{\@backslashchar#1}\fi}
\def\web@outdated#1{\PackageWarningNoLine{tex8web}{#1 has changed or gone,
    and tex8web needs updating for it}}

% xcolor: the names of the colors the document defines, once each, for
% tex8web-page.tex to give MathJax their values. \definecolor, \colorlet,
% \providecolor, and the color sets all log the name, expanded, with
% \XC@logdef. The options dvipsnames, svgnames, and x11names define their
% colors while xcolor loads, before its after hook, so the wrapper is also
% installed as their files are read. The test for \XC@logdef is for the
% color package's dvips driver, which reads dvipsnam.def before xcolor
% defines \XC@logdef.
% \g__web_xcolor_bool: whether xcolor came before colortbl, for colortbl's
% cells. colortbl does not load xcolor, but colortbl.4ht does, after the
% color package has made the document's colors, which xcolor then cannot
% read.
\ExplSyntaxOn
\clist_new:N \g__web_colors_clist
\bool_new:N \g__web_xcolor_bool
% xcolor's table option requires colortbl again once xcolor is done. tex4ht
% would then input colortbl-hooks.4ht a second time, and its \newcommand
% would fail, so the hook is removed when colortbl is already loaded.
\AddToHook { package/xcolor/before }
    {
        \@ifpackageloaded { colortbl }
            {
                \web@needs { package:hooks:colortbl.sty }
                \cs_undefine:c { package:hooks:colortbl.sty }
            }
            { \bool_gset_true:N \g__web_xcolor_bool }
    }
\bool_new:N \g__web_record_bool
\cs_new_protected:Npn \__web_record_colors: {
    \bool_lazy_or:nnF { \g__web_record_bool } { ! \cs_if_exist_p:N \XC@logdef }
        {
            \bool_gset_true:N \g__web_record_bool
            \cs_gset_eq:NN \__web_logdef:n \XC@logdef
            \cs_gset:Npn \XC@logdef ##1 {
                \__web_note_color:e {##1}
                \__web_logdef:n {##1}
            }
        }
}
\cs_new_protected:Npn \__web_note_color:n #1 {
    \cs_if_exist:cF { __web_color_ #1 : }
        {
            \cs_gset:cpn { __web_color_ #1 : } { }
            \clist_gput_right:Nn \g__web_colors_clist {#1}
        }
}
\cs_generate_variant:Nn \__web_note_color:n { e }
\AddToHook { package/xcolor/after } { \web@needs { XC@logdef } \__web_record_colors: }
\clist_map_inline:nn { dvipsnam.def, svgnam.def, x11nam.def }
    { \AddToHook { file/#1/before } { \__web_record_colors: } }
\ExplSyntaxOff
