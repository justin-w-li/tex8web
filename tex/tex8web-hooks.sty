% biblatex reads its style files (reading.bbx) and its other files with
% \@@input and lists them with \@addtofilelist, outside the file hooks.
% Before tex4ht reads the .4ht files, a name still marked whose
% \@filelist has a file of that name not read as the document's clears
% its mark, as the hook above would have. The names are compared as
% strings: \CurrentFileUsed is one, and \@filelist's names are not. This
% runs once: the second \begin{document} comes after the .4ht files,
% which tex4ht adds to \@filelist.
\tl_new:N \l__web_basename_tl
\tl_new:N \l__web_ext_tl
\cs_new_protected:Npn \__web_basename:w #1 . #2 . #3 \q_stop
    {
        \tl_set:Nn \l__web_basename_tl {#1}
        \tl_set:Nn \l__web_ext_tl {#2}
    }
\AddToHook { env/document/before }
    {
        \clist_map_inline:Nn \g__web_ownnames_clist
            {
                \cs_if_exist:cT { web@own@ #1 }
                    {
                        \bool_set_false:N \l__web_tree_bool
                        \clist_map_inline:Nn \@filelist
                            {
                                \__web_basename:w ##1 .. \q_stop
                                \bool_lazy_and:nnT
                                    { \str_if_eq_p:Vn \l__web_basename_tl {#1} }
                                    { ! \str_if_eq_p:Vn \l__web_ext_tl { 4ht } }
                                    {
                                        \bool_set_true:N \l__web_tree_bool
                                        \clist_map_inline:cn { web@own@ #1 }
                                            {
                                                \str_if_eq:nnT {####1} {##1}
                                                    { \bool_set_false:N \l__web_tree_bool }
                                            }
                                        \bool_if:NT \l__web_tree_bool
                                            { \clist_map_break: }
                                    }
                            }
                        \bool_if:NT \l__web_tree_bool
                            {
                                \cs_gset_eq:cN { web@keep@ #1 } \c_empty_tl
                                \web@ownfile@clear {#1}
                            }
                    }
            }
        \clist_gclear:N \g__web_ownnames_clist
    }
% tex4ht.sty's \@providesfile adds the name a file gives in \ProvidesFile
% to \@filelist, so tex4ht reads the .4ht of that name. A file of the
% document can give the name of a .4ht, such as glossary.tex: its own name
% from a subfolder, its name without its extension, or another file's
% name. The document's file marked by the hook above lists the name it
% gives as its own, so that the check above does not count the name as
% another file. A file that the hook does not mark gives the name as the
% document's when the file is in a folder of the document, as when it is
% read by a relative path or through \input@path, and when it is read by
% an absolute path, which the writer named. The primitive \input runs no
% file hook, and from the document it leaves the current file empty, also
% in a file that such a file reads: the document named the file that
% gives the name, by any path, so the name is the document's. (Before the
% class, tex4ht.sty has not yet wrapped \@providesfile, and LaTeX's
% \@providesfile lists no name.) From a package, class, or .def file
% beside the document, the primitive \input leaves that file current, and
% the file gives the name as the document's too. A package of the tree
% that reads a style with the primitive \input, as biblatex does, stays
% the current file, so a copy of the style beside the document keeps its
% .4ht. A name found only in the tree is a package's.
\bool_new:N \l__web_ownprov_bool
\cs_new_eq:NN \__web_providesfile:w \@providesfile
\cs_gset_protected:Npn \@providesfile #1
    {
        \bool_set_false:N \l__web_ownprov_bool
        \exp_last_unbraced:No \__web_basename:w \CurrentFileUsed .. \q_stop
        \tl_if_empty:NTF \CurrentFilePathUsed
            {
                \cs_if_exist:cT { web@own@ \l__web_basename_tl }
                    {
                        \clist_if_in:cVT { web@own@ \l__web_basename_tl } \CurrentFileUsed
                            {
                                \clist_gput_right:cn { web@own@ \l__web_basename_tl } { {#1} }
                                \bool_set_true:N \l__web_ownprov_bool
                            }
                    }
                \bool_lazy_or:nnT
                    { \tl_if_empty_p:N \CurrentFileUsed }
                    { \file_if_exist_p:n { ./ \CurrentFileUsed } }
                    { \bool_set_true:N \l__web_ownprov_bool }
            }
            {
                \file_if_exist:nT
                    {
                        \str_if_eq:eeF { \str_head:N \CurrentFilePathUsed } { / } { ./ }
                        \CurrentFilePathUsed / \CurrentFileUsed
                    }
                    { \bool_set_true:N \l__web_ownprov_bool }
            }
        \__web_basename:w #1 .. \q_stop
        \bool_lazy_all:nT
            {
                { \l__web_ownprov_bool }
                { ! \cs_if_exist_p:c { web@keepext@ \l__web_ext_tl } }
                { ! \cs_if_exist_p:c { web@keep@ \l__web_basename_tl } }
                {
                    \bool_lazy_or_p:nn
                        { \file_if_exist_p:n { ./ #1 } }
                        { ! \file_if_exist_p:n {#1} }
                }
            }
            {
                \cs_gset_eq:cN { \l__web_basename_tl :4ht } \c_empty_tl
                \clist_if_exist:cF { web@own@ \l__web_basename_tl }
                    {
                        \clist_new:c { web@own@ \l__web_basename_tl }
                        \clist_gput_right:NV \g__web_ownnames_clist \l__web_basename_tl
                    }
                \clist_gput_right:cn { web@own@ \l__web_basename_tl } { {#1} }
            }
        \__web_providesfile:w {#1}
    }
\ExplSyntaxOff
