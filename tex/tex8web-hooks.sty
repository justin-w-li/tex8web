% tex8web: records of the preamble settings that tex4ht discards, the names
% that dcolumn.4ht patches, and \web@needs for every module. tex8web.mk4
% loads this package with tex4ht, before the preamble. The rest of tex8web
% is read after \begin{document} (tex8web-core.tex).
\ProvidesPackage{tex8web-hooks}

% titlesec: tex4ht makes \titleformat do nothing and draws headings its own
% way. Each heading's format (font and alignment), shape, label, and space
% after the label are kept for tex8web-page.tex and tex8web-text.tex, as
% \web@titlefont@<name>, \web@titleshape@<name>, \web@titlelabel@<name>,
% and \web@titlesep@<name>. The shapes display and frame put the space
% elsewhere, so it is not kept for them.
% titlesec defines \ttl@makeline only in its heading code, which tex4ht
% does not run, and \titlerule and \titleline call it (titlesec.sty).
% Defined here, \ttl@makeline lets a format that holds them be typeset to
% read its font, and lets them build as paragraphs of the text.
\AddToHook{package/titlesec/after}{%
    \providecommand\ttl@makeline[1]{#1}%
    \let\web@titleformat\titleformat
    \def\titleformat{\@ifstar\web@titleformat@s\web@titleformat@i}%
}
\def\web@titleformat@s#1#2{%
    \web@titlenote{font}{#1}{#2}%
    \web@titleformat*{#1}{#2}%
}
\def\web@titleformat@i#1{%
    \@ifnextchar[{\web@titleformat@ii{#1}}{\web@titleformat@ii{#1}[hang]}%
}
\def\web@titleformat@ii#1[#2]#3#4#5{%
    \web@titlenote{font}{#1}{#3}%
    \web@titlenote{shape}{#1}{#2}%
    \web@unlesshash{#4}{\web@titlenote{label}{#1}{#4}%
        \in@{,#2,}{,display,frame,}\ifin@\else\web@titlenote{sep}{#1}{#5}\fi}%
    \web@titleformat{#1}[#2]{#3}{#4}{#5}%
}
% only for a heading named by one command, \section. titlesec's key form,
% name=\section, is not handled.
\def\web@titlenote#1#2#3{%
    \if\relax\detokenize\expandafter{\@gobble#2}\relax
        \expandafter\gdef\csname web@title#1@\expandafter\@gobble\string#2\endcsname{#3}%
    \fi
}
% #2 unless #1 holds a #. A # stands for the title, which only titlesec's
% heading code fills in (option explicit).
\ExplSyntaxOn
\cs_new:Npn \web@unlesshash #1#2 { \str_if_in:nnF {#1} { \c_hash_str } {#2} }
\ExplSyntaxOff

% tcolorbox: the options whose effect cannot be read from a box as tex4ht
% draws it (tex8web-boxes.tex), recorded as they are set, from the preamble
% on: a hidden frame or interior, the space before and after, and the
% title's place. A box inside another starts again from tcolorbox's
% defaults (\tcb@reset), and so do these records. Once set, frame hidden
% and interior hidden stay for the box: a later option cannot clear them.
\def\web@tcb@reset{%
    \let\web@tcb@framehidden\relax
    \let\web@tcb@interiorhidden\relax
    \let\web@tcb@before\relax
    \let\web@tcb@after\relax
    \let\web@tcb@boxed\relax % a boxed title's place: left, center, or right
    \let\web@tcb@inline\relax % the title starts the text
}
% runs #2 when option #1 is set. Each option is hooked once, as soon as
% tcolorbox or one of its libraries defines it.
\def\web@tcb@note#1#2{%
    \pgfkeysifdefined{/tcb/#1/.@cmd}{\pgfkeysifdefined{/tcb/#1/web@noted}{}{%
        \pgfkeyssetvalue{/tcb/#1/web@noted}{}%
        \tcbset{#1/.append code={#2}}}}{}%
}
\def\web@tcb@notes{%
    \web@tcb@note{frame hidden}{\let\web@tcb@framehidden\@empty}%
    \web@tcb@note{interior hidden}{\let\web@tcb@interiorhidden\@empty}%
    \web@tcb@note{before skip}{\def\web@tcb@before{##1}}%
    \web@tcb@note{after skip}{\def\web@tcb@after{##1}}%
    \web@tcb@note{before skip balanced}{\def\web@tcb@before{##1}}%
    \web@tcb@note{after skip balanced}{\def\web@tcb@after{##1}}%
    \web@tcb@note{attach title to upper}{\let\web@tcb@inline\@empty}%
    \web@tcb@note{attach boxed title to top left}{\def\web@tcb@boxed{left}}%
    \web@tcb@note{attach boxed title to top text left}{\def\web@tcb@boxed{left}}%
    \web@tcb@note{attach boxed title to top center}{\def\web@tcb@boxed{center}}%
    \web@tcb@note{attach boxed title to top text right}{\def\web@tcb@boxed{right}}%
    \web@tcb@note{attach boxed title to top right}{\def\web@tcb@boxed{right}}%
}
\def\web@tcb@install{%
    \web@needs{tcb@reset}%
    \web@needs{tcb@load@library}%
    \web@tcb@reset
    \preto\tcb@reset{\web@tcb@reset}%
    \web@tcb@notes
    \let\web@tcb@load@library\tcb@load@library
    \def\tcb@load@library##1##2{\web@tcb@load@library{##1}{##2}\web@tcb@notes}%
}
\AddToHook{package/tcolorbox/after}{\web@tcb@install}

% imakeidx: under tex4ht, imakeidx runs no index program (imakeidx-hooks.4ht
% passes it noautomatic). It still calls \imki@finalmessage for each index
% that \printindex prints, with the program and options set. The command
% it would run is written to the .aux as a comment, for index.lua. The hook
% runs after the option quiet, which sets \imki@finalmessage to \@gobble.
\AddToHook{package/imakeidx/after}{%
    \web@needs{imki@finalmessage}%
    \def\imki@finalmessage#1{\immediate\write\@auxout{\@percentchar\space
        tex8web index: \imki@program\imki@options#1.idx}}%
}

% dcolumn of 2026-06-04 renamed \DC@centre and \DC@endcentre to
% \DC@center and \DC@endcenter. dcolumn.4ht (2009) patches the old names,
% and stops on them as undefined. tex4ht reads dcolumn.4ht at
% \begin{document}, so the new macros are given the old names for it, and
% its patched macros are copied back after it.
\AddToHook{file/dcolumn.4ht/before}{%
    \ifdefined\DC@centre\else
        \web@needs{DC@center}\web@needs{DC@endcenter}%
        \let\DC@centre\DC@center
        \let\DC@endcentre\DC@endcenter
    \fi
}
\AddToHook{file/dcolumn.4ht/after}{%
    \ifdefined\DC@center
        \let\DC@center\DC@centre
        \let\DC@endcenter\DC@endcentre
    \fi
}

% An active !, as babel's \useshorthands{!} or shortvrb's \MakeShortVerb{\!}
% make it in the preamble. tex4ht reads its .4ht files in \Preamble, which
% the config runs at \begin{document}. tex4ht first resets the catcodes of a
% list of characters (tex4ht.sty), and ! is not in the list. The .4ht files
% use ! as a delimiter (html4.4ht), so \Preamble makes ! ordinary. The
% config's \begin{document} restores its catcode, before babel's begin
% document code. \Preamble is defined by tex4ht.sty, which is loaded after
% this package, and this hook runs again at the config's \begin{document}.
\AddToHook{env/document/before}{%
    \ifdefined\web@Preamble\else
        \global\let\web@Preamble\Preamble
        \gdef\Preamble{\edef\web@bangcatcode{\the\catcode`\!}\catcode`\!=12
            \web@Preamble}%
    \fi
}
\AddToHook{begindocument/before}{\catcode`\!=\web@bangcatcode\relax}

% graphicx, which mathtools loads in \AtBeginDocument, and graphicx and
% ccicons, which doclicense loads in \AtEndPreamble, loaded here instead,
% before \Preamble. tex4ht reads .4ht files in \Preamble only for packages
% loaded by then. A later graphicx has no graphics.4ht, and
% \includegraphics stops at a picture with no .xbb file. A later ccicons
% has no ccicons.4ht, and its icons are letters in a font the page lacks.
% doclicense's load of graphicx also runs with ^ not yet restored to its
% catcode, and stops in graphics.sty at "Missing number".
\def\web@loadearly#1{\@ifpackageloaded{#1}{}{\RequirePackage{#1}}}
\AddToHook{env/document/before}{%
    \@ifpackageloaded{mathtools}{\web@loadearly{graphicx}}{}%
    \@ifpackageloaded{doclicense}{\web@loadearly{graphicx}\web@loadearly{ccicons}}{}%
}

% xr and xr-hyper: xr.4ht and xr-hyper.4ht expect each label of the other
% document's .aux as tex4ht writes it, with \rEfLiNK{anchor}{text} in each
% field. They stop on a label that LaTeX wrote. xr.4ht also stops on the
% name field that tex4ht writes under hyperref. Both \xdef the fields, so
% a robust command in a field stops them too. Each field is read here
% instead. A field that starts with \rEfLiNK becomes xr.4ht's link to the
% other document's page. Any other field is kept as written, so a reference
% to it prints its number, page, or name with no link. A cleveref field
% starts with [, so it is kept as written too, and the number of a cleveref
% label is not changed. xr.4ht also drops the other document's folder from
% an \@input, which \include writes, where xr.sty keeps it. Each .4ht file
% defines \XR@test, so each is wrapped after it is read.
\ExplSyntaxOn
\AddToHook { file/xr.4ht/after } { \__web_xr_wrap: }
\AddToHook { file/xr-hyper.4ht/after } { \__web_xr_wrap: }
% A document may load both xr and xr-hyper. xr.4ht and xr-hyper.4ht each
% save \XR@loop as \XR:loop and wrap it, so the second file's wrapper calls
% itself, and the build loops. The first wrapper is taken off before the
% second file wraps \XR@loop again.
\AddToHook { file/xr.4ht/before } { \__web_xr_unwrap: }
\AddToHook { file/xr-hyper.4ht/before } { \__web_xr_unwrap: }
\cs_new_protected:Npn \__web_xr_unwrap:
  { \cs_if_exist:NT \XR:loop { \cs_set_eq:NN \XR@loop \XR:loop } }
% (the same for their hooks files, xr-hooks.4ht and xrhyper-hooks.4ht,
% which tex4ht reads as each package loads: each makes the same regex
% \l_xref_filename with \regex_new:N, and the second stops with "already
% defined". tex4ht read the macros that input them, from usepackage.4ht,
% when this package loaded.)
\tl_gput_left:cn { package:hooks:xr.sty } { \cs_undefine:N \l_xref_filename }
\tl_gput_left:cn { package:hooks:xr-hyper.sty } { \cs_undefine:N \l_xref_filename }
\cs_new_protected:Npn \__web_xr_wrap:
  {
    \web@needs { XR@test }
    \web@needs { xr:rEfLiNK }
    \cs_gset_eq:NN \__web_xr_test:w \XR@test
    \cs_gset_eq:NN \XR@test \__web_xr_read:w
  }
% xr and xr-hyper read the URL of the other document's PDF after the file,
% as in \externaldocument[prefix]{file}[url]. tex4ht's \XR@
% (xr-hooks.4ht for xr, xrhyper-hooks.4ht for xr-hyper) reads no URL, so
% the URL is left in the preamble, where it stops the build. The URL is
% read and dropped here, and a reference links to the other document's
% page as without a URL. xr's \XR@cite, which reads the arguments and
% calls \XR@, is redefined to read the URL. Its \XR@ is tex4ht's, which
% is defined after package/xr/after.
% xr's old release, which \usepackage{xr}[=v5] loads, reads no URL, and
% its \XR@ reads [prefix]{file}, where tex4ht's reads [prefix][url]{file},
% so the build stops in the preamble. Its \externaldocument, and the copy
% \externalcitedocument, call \__web_xr_old:w instead, which does what
% tex4ht's \XR@ does with the old release's arguments. The old release
% reads an \@input file name as written, beside this document. Its \XR@
% is kept as \__web_xr_old_import:w, since xr-hyper, loaded later,
% replaces \XR@ and tex4ht's \XR: with its own, which read the arguments
% differently.
% \__web_xr_old_read:nn clears the \filename@area that \__web_xr_old:w's
% \filename@parse left, so \__web_xr_read:w puts no folder in front of it.
\AddToHook { package/xr/after } { \__web_xr_url_wrap: }
\AddToHook { package/xr-hyper/after } { \__web_xr_url_wrap: }
\cs_new_nopar:Npn \__web_xr_old_release: { \@ifnextchar [ \XR@ { \XR@ [ ] } }
\cs_new_protected:Npn \__web_xr_url_wrap:
  {
    \cs_if_eq:NNTF \externaldocument \__web_xr_old_release:
      {
        \cs_gset_eq:NN \__web_xr_old_import:w \XR@
        \cs_gset_protected:Npn \externaldocument { \@testopt \__web_xr_old:w { } }
        \cs_gset_eq:NN \externalcitedocument \externaldocument
      }
      {
        \web@needs { XR@cite }
        \cs_gset_protected:Npn \XR@cite [##1] { \@testopt { \__web_xr_url:w [##1] } { } }
      }
  }
% (as xr-hooks.4ht's \XR@: the other document's folder, for its links, its
% .xref, and the old release's \XR@ at the beginning of the document)
\cs_new_protected:Npn \__web_xr_old:w [#1] #2
  {
    \web@needs { :declare:xref:files }
    \filename@parse {#2}
    \cs_gset:cpe { xr:dir: \filename@base } { \filename@area }
    \use:c { :declare:xref:files } { \filename@area \filename@base } { \filename@area }
    \Configure { AtBeginDocument } { \__web_xr_old_read:nn {#1} {#2} } { }
  }
\cs_new_protected:Npn \__web_xr_old_read:nn #1#2
  {
    \group_begin:
      \tl_clear:N \filename@area
      \__web_xr_old_import:w [#1] {#2}
    \group_end:
  }
\cs_new_protected:Npn \__web_xr_url:w [#1] [#2] #3
  { \@ifnextchar [ { \__web_xr_drop:nnnw {#1} {#2} {#3} } { \XR@ [#1] [#2] {#3} } }
\cs_new_protected:Npn \__web_xr_drop:nnnw #1#2#3 [#4] { \XR@ [#1] [#2] {#3} }
% (#1 to #4 as in xr.4ht's \XR@test: an .aux line's first token, its next
% two arguments, and the rest)
\cs_new_protected:Npn \__web_xr_read:w #1#2#3#4 \XR@
  {
    \token_if_eq_meaning:NNTF #1 \@input
      {
        \edef \XR@list { \XR@list \filename@area #2 \relax }
        \__web_xr_next:
      }
      {
        \token_if_eq_meaning:NNTF #1 \newlabel
          {
            \str_if_in:nnTF {#2} { @cref }
              { \tl_gset:ce { r@ \XR@prefix #2 } { \tl_map_function:nN {#3} \__web_xr_field:n } }
              {
                \tl_gset:ce { r@ \XR@prefix #2 }
                  {
                    \exp_args:NNe \__web_xr_field:Nn \__web_xr_number:n { \tl_head:n {#3} }
                    \exp_args:Ne \tl_map_function:nN { \tl_tail:n {#3} } \__web_xr_field:n
                  }
              }
            \__web_xr_next:
          }
          { \__web_xr_test:w #1 {#2} {#3} #4 \XR@ }
      }
  }
\cs_new_protected:Npn \__web_xr_next:
  { \ifeof \@inputcheck \exp_after:wN \XR@aux \else \exp_after:wN \XR@read \fi }
% (#1 keeps a field that is not \rEfLiNK: \exp_not:n, or
% \__web_xr_number:n for the number)
\cs_new:Npn \__web_xr_field:Nn #1#2
  { { \__web_xr_if_link:w \q_mark #2 \q_mark \rEfLiNK \q_stop { \__web_xr_link:w #2 } { #1 {#2} } } }
\cs_new:Npn \__web_xr_field:n { \__web_xr_field:Nn \exp_not:n }
\cs_new:Npn \__web_xr_number:n #1 { \exp_not:n { \__web_xr_text:n {#1} } }
\cs_new:Npn \__web_xr_if_link:w #1 \q_mark \rEfLiNK #2 \q_stop { \tl_if_empty:nTF {#1} }
\cs_new:Npn \__web_xr_link:w \rEfLiNK #1#2 { \xr:rEfLiNK \rEfLiNK {#1} \exp_not:n { {#2} } }
% (\g__web_xr_hyperref_bool tells whether a \hyperref is around the
% reference, since its text may be empty.)
\bool_new:N \g__web_xr_hyperref_bool
\tl_new:N \g__web_xr_text_tl
\tl_new:N \l__web_xr_text_tl
% (true in a \cref: tex8web-text.tex's \web@setcref sets it to
% \@firstoftwo)
\cs_new_eq:NN \web@xr@cref \use_ii:nn
\cs_new:Npn \__web_xr_text:n #1
  {
    \web@xr@cref
      % (in a \cref, cleveref prints the number, and this field prints
      % nothing and opens no link, so the \EndLink after the number
      % closes none)
      { \web@xr@endlink }
      {
        \bool_if:NTF \g__web_xr_hyperref_bool
          % (the text of the \hyperref around the reference, once, so a
          % reference in that text prints its own number)
          { \web@xr@hyperref }
          % (the name that \autoref put in \:autoref, as tex4ht's labels
          % print it, then the number. Elsewhere the field expands to the
          % number, as tex4ht's own labels do, for \getrefnumber in an
          % \edef such as \ifthenelse's or a label's.)
          { \cs_if_exist:cT { :autoref } { \use:c { :autoref } { } } #1 }
      }
  }
% (protected, with names that the .aux can hold, since they run only as
% text prints)
\cs_new_protected:Npn \web@xr@endlink { \cs_set_eq:NN \EndLink \scan_stop: }
\cs_new_protected:Npn \web@xr@hyperref
  {
    \tl_set_eq:NN \l__web_xr_text_tl \g__web_xr_text_tl
    \__web_xr_hyperref_clear:
    \tl_use:N \l__web_xr_text_tl
  }
\cs_new_protected:Npn \__web_xr_hyperref_clear:
  {
    \bool_gset_false:N \g__web_xr_hyperref_bool
    \tl_gclear:N \g__web_xr_text_tl
  }
% (hyperref.4ht's \label@@hyperref: its text, kept until the text prints,
% for a reference to another document's label that LaTeX wrote)
\AddToHook { file/hyperref.4ht/after } { \__web_xr_wrap_hyperref: }
\cs_new_protected:Npn \__web_xr_wrap_hyperref:
  {
    \web@needs { label@@hyperref }
    \cs_gset_eq:NN \__web_xr_hyperref:Nnn \label@@hyperref
    \cs_gset:Npn \label@@hyperref ##1##2##3
      {
        \bool_gset_true:N \g__web_xr_hyperref_bool
        \tl_gset:Nn \g__web_xr_text_tl {##3}
        \__web_xr_hyperref:Nnn ##1 {##2} { \__web_xr_hyperref_clear: ##3 }
        \__web_xr_hyperref_clear:
      }
  }
\ExplSyntaxOff

% hyperref's hidelinks, under which tex8web-page.tex leaves links unmarked:
% as a package option, or later in \hypersetup (kvoptions'
% \KV@Hyp@hidelinks). The link colors and \@pdfborder cannot show it,
% since they are the same without it.
%
% hyperref's \H@refstepcounter, which hyperref.sty defines after the
% point where hyperref stops under tex4ht. hypcap's \capstart, topcapt,
% and subcaptionlite call it. cleveref copies it when it loads, after
% this hook, and ltcaption copies it in a longtable. It is tex4ht's
% \refstepcounter, which sets the anchor that a later \caption and \label
% use.
\AddToHook{package/hyperref/after}{%
    \@ifundefined{H@refstepcounter}{\def\H@refstepcounter{\refstepcounter}}{}%
    \@ifpackagewith{hyperref}{hidelinks}{\gdef\web@hidelinks{}}{}%
    \expandafter\let\expandafter\web@hidelinks@kv\csname KV@Hyp@hidelinks\endcsname
    \expandafter\def\csname KV@Hyp@hidelinks\endcsname{\gdef\web@hidelinks{}\web@hidelinks@kv}%
}

% hyperref's anchors, each name once, as in the PDF, where pdfTeX ignores
% a repeated destination. hypcap's \capstart in a float without a caption
% writes an anchor and steps the counter back, so the next float's anchor
% has the same name.
\AddToHook{file/hyperref.4ht/after}{%
    \web@needs{hyper@anchorstart}%
    \let\web@anchorstart\hyper@anchorstart
    \let\web@anchorend\hyper@anchorend
    \def\hyper@anchorstart#1{%
        \ifcsname web@anchor@#1\endcsname
            \global\let\web@anchor@end\relax
        \else
            \global\expandafter\let\csname web@anchor@#1\endcsname\@empty
            \global\let\web@anchor@end\web@anchorend
            \web@anchorstart{#1}%
        \fi}%
    \def\hyper@anchorend{\web@anchor@end}%
}

% \@title before any \title, which is the kernel's error. tex8web-text.tex
% compares \@title with it to tell whether the document has a title.
\let\web@notitle\@title

% \web@needs{name}: a warning unless \<name>, which tex8web patches or
% calls, is defined. npm test fails on the warning, so a tex4ht or package
% release that drops the command shows in the tests instead of as a wrong
% page. The argument is a name so that tex4ht's commands, such as
% :tableofcontents, can be given.
\def\web@needs#1{\ifcsname#1\endcsname\else\web@outdated{\@backslashchar#1}\fi}
\def\web@outdated#1{\PackageWarningNoLine{tex8web}{#1 has changed or gone,
    and tex8web needs updating for it}}

% A package asked for again: tex4ht.sty's wrapper of \@onefilewithoptions
% inputs the package's .4ht files from a one-shot \@reset@ptions, which
% LaTeX runs before it reads a new package. For a package already loaded,
% LaTeX runs it only at the end, after the option code of a package with key
% options, and xcolor's table key loads colortbl there. That load saves the
% one-shot in the same scratch macro, \:temp, which usepackage.4ht then
% redefines, and the one-shot leaves \@reset@ptions broken: every later
% package load fails. tex4ht has read a loaded package's .4ht files, so a
% package asked for again skips the wrapper. This also keeps colortbl's
% hooks from being read twice, which fails, when colortbl comes before
% xcolor's table option. LaTeX marks a package loaded under its name
% without a folder, so the test drops the folder of a name such as
% sty/mypackage, as LaTeX does.
\ExplSyntaxOn
\web@needs { :onefilewithoptions }
\tl_new:N \l__web_load_dir_tl
\tl_new:N \l__web_load_name_tl
\tl_new:N \l__web_load_ext_tl
\cs_set_eq:NN \web@onefilewithoptions \@onefilewithoptions
\cs_set:Npn \@onefilewithoptions #1[#2][#3]#4
    {
        \file_parse_full_name:nNNN {#1.#4}
            \l__web_load_dir_tl \l__web_load_name_tl \l__web_load_ext_tl
        \@ifl@aded {#4} { \l__web_load_name_tl }
            { \:onefilewithoptions #1[#2][#3]{#4} }
            { \web@onefilewithoptions #1[#2][#3]{#4} }
    }
\ExplSyntaxOff

% xcolor: the names of the colors the document defines, once each, for
% tex8web-page.tex to give MathJax their values. \definecolor, \colorlet,
% \providecolor, and the color sets all log the name, expanded, with
% \XC@logdef. The options dvipsnames, svgnames, and x11names define their
% colors while xcolor loads, before its after hook, so the wrapper is also
% installed as their files are read. The test for \XC@logdef is for the
% color package's dvips driver, which reads dvipsnam.def before xcolor
% defines \XC@logdef.
% \g__web_xcolor_bool: whether xcolor came before colortbl, for colortbl's
% cells. colortbl does not load xcolor, but colortbl.4ht does, after the
% color package has made the document's colors, which xcolor then cannot
% read.
\ExplSyntaxOn
\clist_new:N \g__web_colors_clist
\bool_new:N \g__web_xcolor_bool
