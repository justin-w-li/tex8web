{
  "name": "tex8web",
  "version": "0.1.0",
  "description": "LaTeX to web pages that look like the PDF: tex4ht + MathJax, with the math typeset at build time",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justin-w-li/tex8web.git"
  },
  "homepage": "https://justin-w-li.github.io/tex8web/",
  "bugs": "https://github.com/justin-w-li/tex8web/issues",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "tex8web": "bin/tex8web"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:visual": "out=$(mktemp); node --test test/chrome.test.mjs test/shots.test.mjs >$out 2>&1 & tools=$!; node test/visual.mjs && node test/page.mjs; code=$?; wait $tools || code=1; cat $out; rm -f $out; exit $code",
    "test:page": "node test/page.mjs",
    "examples": "node test/examples.mjs",
    "regress": "node test/regress.mjs",
    "clean": "node test/clean.mjs"
  },
  "dependencies": {
    "@mathjax/mathjax-bbm-font-extension": "4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "4.1.3",
    "@mathjax/mathjax-dsfont-font-extension": "4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "4.1.3",
    "@mathjax/mathjax-pagella-font": "4.1.3",
    "@mathjax/mathjax-schola-font": "4.1.3",
    "@mathjax/mathjax-termes-font": "4.1.3",
    "@mathjax/mathjax-tex-font": "4.1.3",
    "mathjax": "4.1.3",
    "subset-font": "2.9.0"
  }
}
