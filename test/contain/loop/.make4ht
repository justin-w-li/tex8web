-- make4ht runs this file as Lua: what the fifo case leaves, a directory
-- without permissions holding a file, a tree deeper than the host's limit
-- on a path, and a FIFO last, which the kill case waits for, before
-- main.tex loops. And a FIFO and a directory without permissions in the
-- document's build directory, which the host reads before the next build
os.execute('mkfifo build/escaped-fifo && mkdir build/closed && chmod 000 build/closed'
  .. ' && cd "$TEX8WEB_LATEX_SAVE" && mkdir escaped-closed && touch escaped-closed/file && chmod 000 escaped-closed'
  .. ' && (for i in $(seq 600); do mkdir d && cd d; done && touch file) && mkfifo escaped-fifo')
