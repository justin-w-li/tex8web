\newcommand\longnote[1]{\footnote{#1: a long footnote, so that the notes
  beside the text reach far below the paragraph with their marks. It goes
  on for several lines in the margin, with words that fill each line of
  the narrow column there, and more words after them, until the note is
  taller than the paragraph and the list that follow it.}}
