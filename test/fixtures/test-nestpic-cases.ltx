% The cases of test-nestpic and test-nestpic-hyperref. Each case's text
% is "Before <case>." and "After <case>.", which run.mjs reads.
%
% A box that holds a TikZ or pgf picture, placed inside another TikZ
% picture or a LaTeX picture, which is drawn as one picture:
% - lrbox, \setbox, \sbox, \savebox, and a pgfpicture in a box;
% - two boxes in one picture, three levels made with \sbox, and a box
%   beside such a three-level box in one picture, before it and after it;
% - an environment that draws its box with a tikzpicture node and holds
%   another such environment: alone, in a theorem, with two inner boxes,
%   with an inner box and then a box of three levels, with a list after the
%   inner box, and with a footnote;
% - three levels of such environments, alone and in a theorem in a list;
% - a box in a \tikz node, in a theorem and in a footnote;
% - a box in a LaTeX picture, in a center, and after a link that holds
%   such a box, or bold text without hyperref.
%
% Pictures the nesting must not break:
% - copies of such a box in text and in \fbox;
% - a later picture;
% - a picture written directly in a node, a minipage in a node, tcolorbox,
%   and mdframed.
%
% The text that an outer environment holds is drawn in its picture, as in
% the PDF, and is not the page's text.
\usepackage{tikz}
\usepackage{tcolorbox}
\tcbuselibrary{skins}
\usepackage[framemethod=tikz]{mdframed}
\newtheorem{thm}{Theorem}
\newsavebox{\bx}
\newsavebox{\sv}
\newsavebox{\outerbx}
\newsavebox{\innerbx}
\newsavebox{\bxa}
\newsavebox{\bxb}
\newsavebox{\bxc}
\newsavebox{\bxd}
\newsavebox{\midbx}
\newsavebox{\bxe}
\newenvironment{outerbox}{\begin{lrbox}{\outerbx}\begin{minipage}{0.8\textwidth}}{%
  \end{minipage}\end{lrbox}\begin{center}\begin{tikzpicture}\node[draw]{\usebox{\outerbx}};\end{tikzpicture}\end{center}}
\newenvironment{innerbox}{\begin{lrbox}{\innerbx}\begin{minipage}{0.6\textwidth}}{%
  \end{minipage}\end{lrbox}\begin{center}\begin{tikzpicture}\node[draw]{\usebox{\innerbx}};\end{tikzpicture}\end{center}}
\newenvironment{midbox}{\begin{lrbox}{\midbx}\begin{minipage}{0.7\textwidth}}{%
  \end{minipage}\end{lrbox}\begin{center}\begin{tikzpicture}\node[draw]{\usebox{\midbx}};\end{tikzpicture}\end{center}}
