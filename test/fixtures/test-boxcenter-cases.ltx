% The cases of test-boxcenter and test-boxcenter-hyperref. Each case's
% text is "Before <case>." and "After <case>.", which run.mjs reads.
%
% A centered block in a minipage saved with lrbox, \sbox, or \savebox and
% placed in a TikZ node, which is drawn as one picture:
% - a center with text and an \fbox, between two lines of text;
% - a center with an \includegraphics, after a line of text;
% - \centering with inline math, in a minipage saved with \sbox;
% - a center with inline math and a \\, with \savebox;
% - the centering environment, ragged2e's \Centering, and a \parbox with
%   \centering in a \savebox;
% - an \fbox and a \framebox of a given width, with no center;
% - a center in italic and sans-serif text, and in a theorem;
% - a box in a footnote;
% - a center at the start of the box, and an \fbox in a center saved with
%   \savebox;
% - a minipage with a center in a center, two centers in a row, and a
%   center after an itemize;
% - a minipage typed in the node, and a tikzpicture in a centered figure;
% - a box with a center saved in the center of another, first, so that the
%   cases after it show a fault that the nested box leaves.
%
% The boxes saved with \sbox and \savebox are saved between paragraphs.
% Each box but one starts with a line of text at its left edge, which
% run.mjs measures from. A box that starts with its center is measured
% from the line below it.
%
% Cases the fix must not break: the same box placed with \usebox in the
% running text keeps its center and its \fbox, for a box saved with lrbox
% and one saved with \sbox, and a center outside any saved box. The case
% with ragged2e's \Centering is a guard too.
\usepackage{graphicx}
\usepackage{ragged2e}
\usepackage{tikz}
