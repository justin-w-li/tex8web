% The cases of test-boxcenter and test-boxcenter-hyperref. Each case's
% text is "Before <case>." and "After <case>.", which run.mjs reads.
%
% A centered block in a minipage saved with lrbox, \sbox, or \savebox and
% placed in a TikZ node, which is drawn as one picture:
% - a center with text and an \fbox, between two lines of text;
% - a center with an \includegraphics, after a line of text;
% - \centering with inline math, in a minipage saved with \sbox;
% - a center with inline math and a \\, then a display, with \savebox;
% - the centering environment, ragged2e's \Centering, and a \parbox with
%   \centering in a \savebox;
% - an \fbox and a \framebox of a given width, with no center;
% - a center in italic and sans-serif text, and in a theorem;
% - a box in a footnote.
%
% The boxes saved with \sbox and \savebox are saved between paragraphs.
% Each box starts with a line of text at its left edge, which run.mjs
% measures from.
%
% Cases the fix must not break: the same box placed with \usebox in the
% running text keeps its center and its \fbox, and a center outside any
% saved box.
\usepackage{graphicx}
\usepackage{ragged2e}
\usepackage{tikz}
\newtheorem{theorem}{Theorem}
\newsavebox{\keep}
\begin{document}
Before repro.
\begin{lrbox}{\keep}\begin{minipage}{6cm}
A
\begin{center}B \fbox{C}\end{center}
D
\end{minipage}\end{lrbox}
\tikz\node[draw]{\usebox{\keep}};

