\begin{picture}(160,40)\put(0,0){\begin{tabular}{|>{\bfseries}l|p{2cm}|}DeltaBold & DeltaPar\end{tabular}}\end{picture}
After column types.
\fi

Before star.
\begin{picture}(160,30)\put(0,0){\begin{tabular*}{140pt}{l@{\extracolsep{\fill}}r}Left & Right\end{tabular*}}\end{picture}
After star.

\ifdefined\tabularx
Before tabularx.
\begin{picture}(160,30)\put(0,0){\begin{tabularx}{140pt}{|l|X|}Xone & Xtwo\end{tabularx}}\end{picture}
After tabularx.
\fi

Before nested.
