; A xindy style for test-glossaries-xdy.tex, trimmed from the one
; glossaries writes: page numbers only, and markup that prints
; "Sorted with our own style." above the glossary.

(require "tex.xdy")

(define-attributes (("default" "glsnumberformat" "pageglsnumberformat")))

(define-location-class "arabic-page-numbers"
   ( :sep "{}{" "arabic-numbers" :sep "}" )
   :min-range-length 2
)

(define-location-class-order ("arabic-page-numbers"))

(markup-index
   :open "\glossarysection[\glossarytoctitle]{\glossarytitle}Sorted with our own style.\par\glossarypreamble
\providecommand*\glsXpageXglsnumberformat[2]{\setentrycounter[#1]{page}\glsnumberformat{#2}}
\begin{theglossary}\glossaryheader~n"
   :close "%~n\end{theglossary}\glossarypostamble~n"
   :tree)
(markup-letter-group-list :sep "\glsgroupskip~n")
(markup-letter-group :open-head "\glsgroupheading{" :close-head "}")
(markup-indexentry :open "\relax\glsresetentrylist~n")
(markup-locclass-list :open "{\glossaryentrynumbers{\relax "
   :sep ", " :close "}}")
(markup-locref-list :sep "\delimN ")
(markup-range :sep "\delimR ")
(markup-locref :open "~n\glsXpageXglsnumberformat"
   :close ""
   :attr "pageglsnumberformat")
