% A bibliography style of test-provname-bbx.tex, beside the document. It
% stands for a copy of a biblatex style that tex4ht configures, debug.4ht
% here, that a document ships beside it. It gives the numeric style's
% entries.
\ProvidesFile{debug.bbx}[2024/01/01 v1.0 Bibliography style of the document]
\RequireBibliographyStyle{numeric}
