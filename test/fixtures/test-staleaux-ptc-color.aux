\relax 
\@writefile{toc}{\contentsline {section}{\numberline {1}First}{1}{}\protected@file@percent }
\ttl@writefile{ptc}{\ttl@starttoc{default@1}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.1}\textcolor {red}{Old subsection}}{1}{}\protected@file@percent }
\ttl@finishall
\gdef \@abspage@last{1}
